// Clements Command & Control — Prisma schema
// Sandbox uses SQLite (local file). For production, change datasource.provider
// to "postgresql" and point DATABASE_URL at Postgres (see README / deploy guide).
//
// SQLite has no native enums, so "type"/"status"/"severity" are strings with
// documented allowed values. Column/table names are mapped to snake_case to
// match the spec while keeping idiomatic camelCase in TypeScript.

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  technicians Technician[]
  users       User[]
  invoices    Invoice[]
  movements   StockMovement[]

  @@map("warehouses")
}

// Field employees (the people stock is checked out to). Not app logins.
model Technician {
  id              String  @id @default(cuid())
  name            String
  homeWarehouseId String  @map("home_warehouse_id")
  employeeIdCard  String? @map("employee_id_card") // FDACS card #, optional
  role            String  @default("Technician") // Technician | Manager | Sales Advisor
  division        String? // Lawn | Service | General Pest
  active          Boolean @default(true)

  homeWarehouse Warehouse       @relation(fields: [homeWarehouseId], references: [id])
  movements     StockMovement[]

  @@index([homeWarehouseId])
  @@map("technicians")
}

// Managers only — v1 has no technician logins.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("manager") // "employee" | "manager" | "admin"
  warehouseId  String?  @map("warehouse_id") // null = access to all warehouses
  branch       String? // "vero" | "stuart" | "orlando" | "naples" — home branch (null = all-branch / exec)
  employeeId   String?  @unique @map("employee_id") // personnel profile (for employee logins)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  warehouse Warehouse?      @relation(fields: [warehouseId], references: [id])
  employee  Employee?       @relation(fields: [employeeId], references: [id])
  sessions  Session[]
  invoices  Invoice[]
  movements StockMovement[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Master chemical catalog.
model Product {
  id             String  @id @default(cuid())
  name           String
  manufacturer   String?
  epaRegNumber   String? @map("epa_reg_number")
  unitOfMeasure  String  @map("unit_of_measure") // e.g. "jug", "case", "lb", "gal"
  category       String?
  barcode        String? @unique
  distributorSku String? @map("distributor_sku")
  activeIngredient  String? @map("active_ingredient")
  targetPest        String? @map("target_pest")
  applicationMethod String? @map("application_method")
  active          Boolean @default(true)

  invoiceLines InvoiceLine[]
  movements    StockMovement[]
  alerts       Alert[]

  @@map("products")
}

model Invoice {
  id            String   @id @default(cuid())
  distributor   String
  invoiceNumber String   @map("invoice_number")
  invoiceDate   DateTime @map("invoice_date")
  warehouseId   String   @map("warehouse_id")
  filePath      String?  @map("file_path")
  subtotal      Float?
  total         Float?
  status        String   @default("parsed") // "parsed" | "confirmed"
  uploadedById  String?  @map("uploaded_by")
  createdAt     DateTime @default(now()) @map("created_at")

  warehouse  Warehouse       @relation(fields: [warehouseId], references: [id])
  uploadedBy User?           @relation(fields: [uploadedById], references: [id])
  lines      InvoiceLine[]
  movements  StockMovement[]

  @@index([warehouseId])
  @@index([distributor, invoiceNumber])
  @@map("invoices")
}

model InvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String  @map("invoice_id")
  productId      String? @map("product_id")
  descriptionRaw String  @map("description_raw")
  quantity       Float
  unit           String?
  unitPrice      Float?  @map("unit_price")
  lineTotal      Float?  @map("line_total")
  matched        Boolean @default(false)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_lines")
}

// Every stock change is a movement. On-hand = SUM(quantity) per product+warehouse.
// check_in => positive, check_out => negative, adjustment => either sign.
model StockMovement {
  id              String   @id @default(cuid())
  type            String // "check_in" | "check_out" | "adjustment"
  productId       String   @map("product_id")
  warehouseId     String   @map("warehouse_id")
  technicianId    String?  @map("technician_id")
  quantity        Float
  unitPrice       Float?   @map("unit_price")
  sourceInvoiceId String?  @map("source_invoice_id")
  reason          String?
  userId          String?  @map("user_id")
  // Reconciliation: reversals reference the movement they undo. Nothing is ever
  // hard-deleted; a reversed movement stays and gets an offsetting entry.
  reversalOfId    String?  @unique @map("reversal_of_id")
  createdAt       DateTime @default(now()) @map("created_at")

  product       Product        @relation(fields: [productId], references: [id])
  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id])
  technician    Technician?    @relation(fields: [technicianId], references: [id])
  sourceInvoice Invoice?       @relation(fields: [sourceInvoiceId], references: [id])
  user          User?          @relation(fields: [userId], references: [id])
  reversalOf    StockMovement? @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy    StockMovement? @relation("Reversal")

  @@index([productId, warehouseId])
  @@index([warehouseId])
  @@index([type])
  @@index([createdAt])
  @@map("stock_movements")
}

model Alert {
  id        String   @id @default(cuid())
  type      String // "price_increase" | "duplicate_invoice" | "negative_stock" | "quantity_spike"
  productId String?  @map("product_id")
  message   String
  severity  String   @default("warning") // "info" | "warning" | "critical"
  status    String   @default("open") // "open" | "dismissed"
  // De-dupe key so the agent doesn't re-file the same anomaly every run.
  dedupeKey String?  @unique @map("dedupe_key")
  createdAt DateTime @default(now()) @map("created_at")

  product Product? @relation(fields: [productId], references: [id])

  @@index([status])
  @@map("alerts")
}

// ---------------------------------------------------------------------------
// Management reporting (board / management KPIs). Separate from inventory.
// Monthly snapshots of KPIs, each with actual vs budget, at company or branch
// scope. IMPORTANT: manager compensation is never stored or shown here.
// ---------------------------------------------------------------------------

// A reporting month, e.g. 2026-05 ("May 2026 Financials").
model ReportPeriod {
  id        String   @id @default(cuid())
  year      Int
  month     Int // 1-12
  label     String // e.g. "May 2026"
  createdAt DateTime @default(now()) @map("created_at")

  kpiValues   KpiValue[]
  lobRevenues LobRevenue[]
  techProd    TechProduction[]
  leadSources LeadSource[]

  @@unique([year, month])
  @@map("report_periods")
}

// A KPI definition. `group` buckets it in the UI; `higherIsBetter` drives
// favorable/unfavorable variance coloring (revenue up = good, fuel up = bad).
model Kpi {
  id             String  @id @default(cuid())
  key            String  @unique // e.g. "net_revenue", "ebitda_pct"
  label          String
  group          String // "Headline" | "Production" | "RouteContribution" | "PnL" | "Sales" | "Attrition" | "BalanceSheet"
  unit           String  @default("usd") // "usd" | "pct" | "pts" | "count"
  higherIsBetter Boolean @default(true)
  sortOrder      Int     @default(0)

  values KpiValue[]

  @@map("kpis")
}

// One KPI value for a period/scope/basis. scope = "company" or a branch key.
// basis = "month" | "ytd" | "cy_forecast".
model KpiValue {
  id       String @id @default(cuid())
  periodId String @map("period_id")
  kpiKey   String @map("kpi_key")
  scope    String @default("company") // "company" | "vero" | "stuart" | "orlando" | "naples"
  basis    String @default("month") // "month" | "ytd" | "cy_forecast"
  actual   Float?
  budget   Float?

  period ReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  kpi    Kpi          @relation(fields: [kpiKey], references: [key])

  @@unique([periodId, kpiKey, scope, basis])
  @@index([kpiKey])
  @@map("kpi_values")
}

// Revenue by line of business (service category) per branch per period.
model LobRevenue {
  id         String  @id @default(cuid())
  periodId   String  @map("period_id")
  scope      String  @default("company") // "company" | branch key
  lob        String // "Pest" | "Fertilizer" | "L&O" | "Termite" | "Rat" | ...
  revenue    Float   @default(0)
  jobs       Int?
  budget     Float?

  period ReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, scope, lob])
  @@map("lob_revenue")
}

// New-sales lead sources per period/scope. leads/won drive close rate when
// that lead-level data is available (not in the MBR — fed separately).
model LeadSource {
  id           String  @id @default(cuid())
  periodId     String  @map("period_id")
  scope        String  @default("company")
  source       String
  revenueMonth Float   @default(0) @map("revenue_month")
  revenueYtd   Float?  @map("revenue_ytd")
  leads        Int?
  won          Int?

  period ReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, scope, source])
  @@map("lead_sources")
}

// Per-technician production (NOT compensation). Production actual vs budget so
// managers can see who is over/under plan. No wage or comp fields, ever.
model TechProduction {
  id       String  @id @default(cuid())
  periodId String  @map("period_id")
  scope    String // branch key
  techName String  @map("tech_name")
  lob      String? // "PC" | "LO" | "Service" | ...
  actual   Float   @default(0)
  budget   Float   @default(0)

  period ReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([periodId, scope])
  @@map("tech_production")
}

// Quarterly branch-manager bonus scorecard. One row per (quarter, branch,
// metric). Binary Met/Not-Met per the company template; targets are entered by
// the reviewer (some come from the MBR budget, some TBD). Weighted to 100%.
model ScorecardResult {
  id        String   @id @default(cuid())
  year      Int
  quarter   Int // 1-4
  branch    String // "vero" | "stuart" | "orlando" | "naples"
  metricKey String   @map("metric_key")
  target    String? // reviewer-entered target (free text; some TBD)
  met       Boolean? // null = not yet scored
  note      String?
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([year, quarter, branch, metricKey])
  @@index([year, quarter, branch])
  @@map("scorecard_results")
}

// ---------------------------------------------------------------------------
// Fleet management. Vehicle registry + maintenance/repair/cost history, so
// operating cost, cost-per-mile, and replacement timing can be tracked. GPS
// integration (auto next-service scheduling) is a later phase; the next-due
// fields are here so it can slot in.
// ---------------------------------------------------------------------------
model Vehicle {
  id             String    @id @default(cuid())
  unitNumber     String?   @map("unit_number") // fleet unit / asset number
  name           String // e.g. "2019 Ford Transit 250"
  year           Int?
  make           String?
  model          String?
  vin            String?   @unique
  plate          String?
  branch         String? // "vero" | "stuart" | "orlando" | "naples"
  assignedTo     String?   @map("assigned_to") // technician / driver name
  status         String    @default("active") // "active" | "inactive" (sold/retired/etc.)
  acquiredDate   DateTime? @map("acquired_date")
  purchasePrice  Float?    @map("purchase_price")

  // Disposition (when no longer in service). All data is retained; the vehicle
  // just moves to the sold/retired list.
  disposition      String?   // "sold" | "retired" | "totaled" | "traded" | "transferred"
  dispositionDate  DateTime? @map("disposition_date")
  salePrice        Float?    @map("sale_price")
  dispositionNotes String?   @map("disposition_notes")
  currentMileage Int?      @map("current_mileage")
  mileageAsOf    DateTime? @map("mileage_as_of") // date the mileage reading is from
  statusNotes    String?   @map("status_notes") // replacement/condition notes

  // Registration / access / telematics
  driverCard          String?   @map("driver_card") // fuel card (Coast)
  driverLicense       String?   @map("driver_license")
  registrationRenewal DateTime? @map("registration_renewal")
  gps                 String? // GPS device / "NO GPS"

  // Financing (loan). hasLoan is derived from these being present.
  loanBank       String?   @map("loan_bank")
  loanNumber     String?   @map("loan_number")
  monthlyPayment Float?    @map("monthly_payment")
  loanBalance    Float?    @map("loan_balance")
  payoffDate     DateTime? @map("payoff_date") // maturity

  createdAt      DateTime  @default(now()) @map("created_at")

  services    VehicleService[]
  inspections VehicleInspection[]

  @@index([branch])
  @@map("vehicles")
}

model VehicleService {
  id            String    @id @default(cuid())
  vehicleId     String    @map("vehicle_id")
  date          DateTime
  type          String // "oil_change" | "repair" | "inspection" | "tires" | "pm" | "other"
  description   String?
  cost          Float     @default(0)
  mileage       Int? // odometer at service
  vendor        String?
  invoiceRef    String?   @map("invoice_ref")
  nextDueMileage Int?     @map("next_due_mileage")
  nextDueDate   DateTime? @map("next_due_date")
  createdAt     DateTime  @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_services")
}

// Monthly on-site vehicle inspection completed by a branch manager. Mirrors the
// paper form: condition ratings (1-3), a maintenance-log review, and pass/fail
// compliance checks (FDACS / insurance / maintenance). Scores the technician
// assigned to the vehicle and feeds the quarterly scorecard's inspection metric.
model VehicleInspection {
  id             String   @id @default(cuid())
  vehicleId      String   @map("vehicle_id")
  branch         String?
  year           Int
  month          Int // 1-12 — one inspection per vehicle per month
  date           DateTime // date the inspection was performed
  employeeId     String?  @map("employee_id") // personnel profile of the graded driver
  technicianName String?  @map("technician_name") // driver assigned to the vehicle (graded)
  inspectorName  String?  @map("inspector_name") // manager completing the form

  // Section A — condition ratings (1-3) and per-item "issues to address" notes.
  ratings      String @default("{}") // {"outside":3,"inside":2,"toolbox":3,"truckbed":1}
  ratingIssues String @default("{}") @map("rating_issues")

  // Section C — FDACS / insurance / maintenance pass-fail checks (1 pt each).
  checks String @default("{}") // {"id_card":true,"pesticides_locked":true,...}

  // Section B — routine maintenance log review.
  oilChangeLast    DateTime? @map("oil_change_last")
  oilChangeNext    DateTime? @map("oil_change_next")
  tireRotationLast DateTime? @map("tire_rotation_last")
  tireRotationNext DateTime? @map("tire_rotation_next")
  otherMaintLast   DateTime? @map("other_maint_last")
  otherMaintNext   DateTime? @map("other_maint_next")
  mileage          Int?
  notes            String?

  // Computed grade (points earned out of maxScore).
  score    Int    @default(0)
  maxScore Int    @default(20) @map("max_score")
  scorePct Float  @default(0) @map("score_pct")
  grade    String @default("") // A | B | C | D | F

  createdAt DateTime @default(now()) @map("created_at")

  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id])

  @@unique([vehicleId, year, month])
  @@index([branch, year, month])
  @@index([technicianName])
  @@index([employeeId])
  @@map("vehicle_inspections")
}

// ---------------------------------------------------------------------------
// People / HR. A personnel profile for every employee. Inspection reports and
// (future) annual reviews tag to the profile so scores accrue to the person.
// ---------------------------------------------------------------------------
model Employee {
  id            String    @id @default(cuid())
  name          String
  email         String? // work email (for emailing inspection scores); filled later
  phone         String?
  role          String? // "Technician" | "Manager" | "Sales Advisor" | ...
  division      String? // "Lawn" | "Service" | "General Pest" | ...
  branch        String? // "vero" | "stuart" | "orlando" | "naples"
  title         String?
  status        String    @default("active") // "active" | "inactive" (former employee)
  hireDate      DateTime? @map("hire_date")
  terminatedAt  DateTime? @map("terminated_at")
  licenseNumber String?   @map("license_number")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  inspections VehicleInspection[]
  rideAlongs  AuditRideAlong[]
  assignments TrainingAssignment[]
  records     PersonnelRecord[]
  reviews     NewHireReview[]
  separation  EmployeeSeparation?
  user        User?

  @@index([branch])
  @@index([name])
  @@map("employees")
}

// Manager-submitted personnel records about an employee: write-ups, coaching
// notes, recognition, and workplace accident reports. Every submission is
// emailed to HR and filed on the employee's profile.
model PersonnelRecord {
  id           String    @id @default(cuid())
  employeeId   String    @map("employee_id")
  branch       String?
  type         String // "writeup" | "note" | "recognition" | "accident"
  category     String? // writeup: verbal|written|final|pip ; accident: minor|recordable|serious
  title        String?
  body         String?
  incidentDate DateTime? @map("incident_date")
  actionTaken  String?   @map("action_taken")
  followUp     String?   @map("follow_up")
  details      String    @default("{}") // JSON: accident fields + manager checklist state
  attachmentFile String? @map("attachment_file")
  attachmentName String? @map("attachment_name")
  authorId     String?   @map("author_id")
  authorName   String?   @map("author_name")
  hrNotified   Boolean   @default(false) @map("hr_notified")
  acknowledgedAt DateTime? @map("acknowledged_at") // future: employee sign-off
  createdAt    DateTime  @default(now()) @map("created_at")

  employee          Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  signatures        PersonnelSignature[]
  signatureRequests SignatureRequest[]

  @@index([employeeId])
  @@index([branch, type])
  @@map("personnel_records")
}

// Electronic signature on a personnel record (write-up / accident report).
// Typed full name + acknowledgment statement + timestamp + attribution — a
// valid e-signature under E-SIGN / UETA for in-person capture.
model PersonnelSignature {
  id             String   @id @default(cuid())
  recordId       String   @map("record_id")
  role           String // "employee" | "supervisor" | "hr" | "witness"
  signerName     String   @map("signer_name")
  statement      String? // the acknowledgment text agreed to
  signedByUserId String?  @map("signed_by_user_id") // the logged-in user who captured it
  signedAt       DateTime @default(now()) @map("signed_at")

  record PersonnelRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
  @@map("personnel_signatures")
}

// Offboarding record for a terminated / departed employee. Holds the reason,
// supporting documents, and the HR-conducted exit interview (which HR may
// bypass when a separation is not on good terms). Created when an employee is
// moved to inactive; the profile and all linked data are retained.
model EmployeeSeparation {
  id             String  @id @default(cuid())
  employeeId     String  @unique @map("employee_id")
  separationType String  @map("separation_type") // "voluntary" | "involuntary" | "layoff" | "other"
  reasonCategory String? @map("reason_category") // resignation | performance | misconduct | attendance | job_abandonment | layoff | other
  reasonNotes    String? @map("reason_notes")
  lastDay        DateTime @map("last_day")
  rehireEligible Boolean? @map("rehire_eligible")

  // Supporting documents — JSON array of { file, name }.
  docs String @default("[]")

  // HR-conducted exit interview.
  exitStatus       String    @default("pending") // "pending" | "completed" | "bypassed"
  exitBypassReason String?   @map("exit_bypass_reason")
  exitResponses    String    @default("{}") @map("exit_responses") // JSON answers
  exitInterviewAt  DateTime? @map("exit_interview_at")
  exitInterviewBy  String?   @map("exit_interview_by")

  createdByUserId String?  @map("created_by_user_id")
  createdByName   String?  @map("created_by_name")
  createdAt       DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_separations")
}

// New-hire 30 / 60-day review. HR-managed: scheduled off the start date, sent
// to a reviewer (supervisor/coordinator), completed & signed by reviewer +
// employee, then finally approved & signed by the HR director. Three signatures.
model NewHireReview {
  id         String   @id @default(cuid())
  employeeId String   @map("employee_id")
  branch     String?
  type       String // "30_day" | "60_day"
  startDate  DateTime @map("start_date")
  dueDate    DateTime @map("due_date")
  // due -> sent -> in_progress -> pending_approval -> completed
  status     String   @default("due")

  reviewerUserId String? @map("reviewer_user_id")
  reviewerName   String? @map("reviewer_name")

  responses     String  @default("{}") // form answers
  overallRating String? @map("overall_rating")
  nextSteps     String? @map("next_steps")
  hrNotes       String? @map("hr_notes")

  // Three e-signatures.
  reviewerSignedName String?   @map("reviewer_signed_name")
  reviewerSignedAt   DateTime? @map("reviewer_signed_at")
  employeeSignedName String?   @map("employee_signed_name")
  employeeSignedAt   DateTime? @map("employee_signed_at")
  hrSignedName       String?   @map("hr_signed_name")
  hrSignedAt         DateTime? @map("hr_signed_at")

  // Remote-sign token for the employee (emailed link when not on-site).
  employeeToken     String?   @unique @map("employee_token")
  lastReminderAt    DateTime? @map("last_reminder_at")

  hrNotifiedAt DateTime? @map("hr_notified_at")
  sentAt       DateTime? @map("sent_at")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, type])
  @@index([status])
  @@index([branch, status])
  @@map("newhire_reviews")
}

// A remote e-signature request: a tokenized link emailed to a signer who isn't
// with the manager (e.g. an injured employee sent home). They open the link and
// sign without logging in. Reminders re-send daily until signed.
model SignatureRequest {
  id             String    @id @default(cuid())
  recordId       String    @map("record_id")
  role           String
  token          String    @unique
  email          String
  signerName     String?   @map("signer_name")
  sentAt         DateTime  @default(now()) @map("sent_at")
  lastReminderAt DateTime? @map("last_reminder_at")
  signedAt       DateTime? @map("signed_at")
  createdById    String?   @map("created_by_id")

  record PersonnelRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
  @@index([signedAt])
  @@map("signature_requests")
}

// ---------------------------------------------------------------------------
// Training / LMS. Admins create courses (uploaded material + a quiz) and assign
// them to employees with a due date. Completions file into the employee's
// personnel profile and feed the manager scorecard + year-end review.
// ---------------------------------------------------------------------------
model Course {
  id            String   @id @default(cuid())
  title         String
  category      String   @default("ceu") // "onboarding" | "ceu"
  description   String? // lesson body / summary (markdown-ish text)
  materialFile  String?  @map("material_file") // uploaded lesson (pdf/slides), best-effort stored
  materialName  String?  @map("material_name")
  questions     String   @default("[]") // JSON: [{prompt, options:[...], correctIndex}]
  passingScore  Int      @default(80) @map("passing_score") // percent
  active        Boolean  @default(true)
  createdById   String?  @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  assignments TrainingAssignment[]

  @@index([category])
  @@map("courses")
}

model TrainingAssignment {
  id           String    @id @default(cuid())
  courseId     String    @map("course_id")
  employeeId   String    @map("employee_id")
  branch       String? // snapshot of the employee's branch (for manager rollups)
  assignedById String?   @map("assigned_by_id")
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  dueDate      DateTime? @map("due_date")

  status      String    @default("not_started") // "not_started" | "in_progress" | "completed"
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  answers     String    @default("{}") // JSON: {questionIndex: chosenIndex}
  score       Int? // percent
  passed      Boolean?
  attempts    Int       @default(0)

  // Email cadence: assignment notice + daily reminders until complete.
  notifiedAt     DateTime? @map("notified_at")
  lastReminderAt DateTime? @map("last_reminder_at")

  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([courseId, employeeId])
  @@index([employeeId, status])
  @@index([branch, status])
  @@map("training_assignments")
}

// Outbound email log. Every send (or skip when no provider is configured) is
// recorded so admin/HR can see what went out. The sender is provider-agnostic.
model EmailLog {
  id          String   @id @default(cuid())
  to          String
  subject     String
  kind        String // "inspection_score" | "audit_report" | ...
  status      String // "sent" | "skipped_no_provider" | "skipped_no_address" | "error"
  error       String?
  relatedType String?  @map("related_type")
  relatedId   String?  @map("related_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([kind])
  @@map("email_logs")
}

// ---------------------------------------------------------------------------
// Quarterly branch audit (Director of Field Ops). A pre-visit prep checklist,
// the on-site audit form (ride-alongs + facility + personnel), and follow-up
// action items with deadlines that alert the branch manager.
// ---------------------------------------------------------------------------
model BranchAudit {
  id          String   @id @default(cuid())
  branch      String
  year        Int
  quarter     Int // 1-4
  visitDate   DateTime @map("visit_date")
  auditorName String?  @map("auditor_name")
  status      String   @default("draft") // "draft" | "submitted"

  // Section scores stored as JSON keyed by item.
  facility  String @default("{}") // A + B: 1-3 ratings; C: yes/no
  personnel String @default("{}") // yes/no answers
  ratings   String @default("{}") // section overall 1-5 ratings (equipment, personnel)

  facilityIssues  String? @map("facility_issues")
  concerns        String? // branch-specific concerns
  suggestions     String? // engagement / inclusion suggestions
  nextQuarterPlan String? @map("next_quarter_plan")

  score       Int      @default(0)
  maxScore    Int      @default(0) @map("max_score")
  scorePct    Float    @default(0) @map("score_pct")
  submittedAt DateTime? @map("submitted_at")
  createdAt   DateTime @default(now()) @map("created_at")

  rideAlongs AuditRideAlong[]
  followUps  AuditFollowUp[]

  @@unique([branch, year, quarter])
  @@index([branch])
  @@map("branch_audits")
}

model AuditRideAlong {
  id          String  @id @default(cuid())
  auditId     String  @map("audit_id")
  employeeId  String? @map("employee_id")
  technicianName String? @map("technician_name")
  serviceType String? @map("service_type") // general_pest | termite | lawn | mosquito | rodent | other

  // 1-5 ratings.
  customerInteraction Int? @map("customer_interaction")
  serviceExecution    Int? @map("service_execution")
  equipmentPrep       Int? @map("equipment_prep")
  safety              Int?

  customerNotes  String? @map("customer_notes")
  executionNotes String? @map("execution_notes")
  equipmentNotes String? @map("equipment_notes")
  safetyNotes    String? @map("safety_notes")
  strengths      String?
  improvement    String?
  coaching       String?

  audit    BranchAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  employee Employee?   @relation(fields: [employeeId], references: [id])

  @@index([auditId])
  @@map("audit_ride_alongs")
}

model AuditFollowUp {
  id          String    @id @default(cuid())
  auditId     String    @map("audit_id")
  branch      String
  description String
  dueDate     DateTime? @map("due_date")
  status      String    @default("open") // "open" | "done"
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  audit BranchAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([branch, status])
  @@map("audit_follow_ups")
}

// Monthly warehouse safety inspection (FL Statute 482 / FDACS + OSHA). One per
// branch per month; feeds the scorecard's warehouse-inspection compliance.
model WarehouseInspection {
  id            String   @id @default(cuid())
  branch        String
  year          Int
  month         Int
  date          DateTime
  inspectorName String?  @map("inspector_name")

  checks   String @default("{}") // {itemKey: true/false}
  comments String @default("{}") // {itemKey: "corrective action"}
  notes    String?

  score    Int    @default(0)
  maxScore Int    @default(0) @map("max_score")
  scorePct Float  @default(0) @map("score_pct")
  grade    String @default("")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([branch, year, month])
  @@index([branch, year, month])
  @@map("warehouse_inspections")
}

// Pre-visit prep checklist for a branch/quarter (Director of Field Ops).
model AuditPrecheck {
  id        String   @id @default(cuid())
  branch    String
  year      Int
  quarter   Int
  items     String   @default("{}") // {itemKey: true/false}
  notes     String?
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([branch, year, quarter])
  @@map("audit_prechecks")
}

// Simple key/value app settings (e.g. price-increase threshold).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("settings")
}
