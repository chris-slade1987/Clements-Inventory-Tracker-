// Clements Command & Control — Prisma schema
// Sandbox uses SQLite (local file). For production, change datasource.provider
// to "postgresql" and point DATABASE_URL at Postgres (see README / deploy guide).
//
// SQLite has no native enums, so "type"/"status"/"severity" are strings with
// documented allowed values. Column/table names are mapped to snake_case to
// match the spec while keeping idiomatic camelCase in TypeScript.

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  technicians Technician[]
  users       User[]
  invoices    Invoice[]
  movements   StockMovement[]

  @@map("warehouses")
}

// Field employees (the people stock is checked out to). Not app logins.
model Technician {
  id              String  @id @default(cuid())
  name            String
  homeWarehouseId String  @map("home_warehouse_id")
  employeeIdCard  String? @map("employee_id_card") // FDACS card #, optional
  role            String  @default("Technician") // Technician | Manager | Sales Advisor
  division        String? // Lawn | Service | General Pest
  active          Boolean @default(true)

  homeWarehouse Warehouse       @relation(fields: [homeWarehouseId], references: [id])
  movements     StockMovement[]

  @@index([homeWarehouseId])
  @@map("technicians")
}

// Managers only — v1 has no technician logins.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("manager") // "employee" | "manager" | "admin"
  // Access level (the assignable "user level"): "super_admin" | "admin" |
  // "manager" | "technician" | "csr" | "sales". Drives access rights on top of
  // `role` (super_admin & admin both carry role "admin"; "admin" is walled to its
  // team for personnel profiles). Only super admins may change it. See lib/access-levels.ts.
  accessLevel  String?  @map("access_level")
  warehouseId  String?  @map("warehouse_id") // null = access to all warehouses
  branch       String? // "vero" | "stuart" | "orlando" | "naples" — home branch (null = all-branch / exec)
  employeeId   String?  @unique @map("employee_id") // personnel profile (for employee logins)
  active       Boolean  @default(true)
  canPostBulletin Boolean @default(false) @map("can_post_bulletin") // may author company bulletin posts / calendar
  seniorLeadership Boolean @default(false) @map("senior_leadership") // senior leadership group — may view the Compliance Command Center
  hrAccess     Boolean @default(false) @map("hr_access") // HR — may run pre-hire onboarding (+ HR tools)
  boardObserver Boolean @default(false) @map("board_observer") // board member — read-only access to the executive views only
  createdAt    DateTime @default(now()) @map("created_at")

  warehouse Warehouse?      @relation(fields: [warehouseId], references: [id])
  employee  Employee?       @relation(fields: [employeeId], references: [id])
  sessions  Session[]
  invoices  Invoice[]
  movements StockMovement[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Master chemical catalog.
model Product {
  id             String  @id @default(cuid())
  name           String
  manufacturer   String?
  epaRegNumber   String? @map("epa_reg_number")
  // Official Safety Data Sheet (SDS/MSDS) URL — a link to the manufacturer's own
  // SDS PDF (verified only; null when not confidently found). We store the URL
  // only and never host the PDF. Fertilizers/chemicals have SDS; devices usually
  // do not. See prisma/data/product-sds.json + prisma/seed-epa-numbers.ts.
  sdsUrl         String? @map("sds_url")
  unitOfMeasure  String  @map("unit_of_measure") // e.g. "jug", "case", "lb", "gal"
  category       String?
  barcode        String? @unique
  distributorSku String? @map("distributor_sku")
  activeIngredient  String? @map("active_ingredient")
  targetPest        String? @map("target_pest")
  applicationMethod String? @map("application_method")
  active          Boolean @default(true)
  // Governance: whether this product is on the CEO's approved catalog. Off-list
  // products stay usable but are flagged. unitOfMeasure holds a canonical UoM
  // CODE from lib/uom.ts (never free text).
  approved        Boolean @default(true)
  // Case -> unit pack size (e.g. tubes per case). Null until a later step fills
  // it; see unitsFromCases() in lib/uom.ts. No conversion math runs yet.
  unitsPerCase    Int?    @map("units_per_case")
  // Line-of-service classification (additive to `category`). `division` is one of
  // DIVISIONS in lib/constants.ts (GHP | LO | TERMITE | RODENT | OTHER);
  // `subdivision` is one of that division's SUBDIVISIONS. Null for off-catalog
  // products that haven't been classified.
  division        String?
  subdivision     String?
  // Formal-approval gate: `approved` = on the CEO's catalog; `confirmed` = a human
  // has reviewed this row's data. Auto-added products (invoice/history) start
  // unconfirmed and are BLOCKED at check-out until an admin confirms them.
  confirmed       Boolean @default(true)
  // Free-text note (e.g. "added from transfer history — confirm naming").
  notes           String?

  invoiceLines InvoiceLine[]
  movements    StockMovement[]
  alerts       Alert[]

  @@map("products")
}

model Invoice {
  id            String   @id @default(cuid())
  distributor   String
  invoiceNumber String   @map("invoice_number")
  invoiceDate   DateTime @map("invoice_date")
  warehouseId   String   @map("warehouse_id")
  filePath      String?  @map("file_path")
  subtotal      Float?
  total         Float?
  status        String   @default("parsed") // "parsed" | "confirmed"
  uploadedById  String?  @map("uploaded_by")
  createdAt     DateTime @default(now()) @map("created_at")

  warehouse  Warehouse       @relation(fields: [warehouseId], references: [id])
  uploadedBy User?           @relation(fields: [uploadedById], references: [id])
  lines      InvoiceLine[]
  movements  StockMovement[]

  @@index([warehouseId])
  @@index([distributor, invoiceNumber])
  @@map("invoices")
}

model InvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String  @map("invoice_id")
  productId      String? @map("product_id")
  descriptionRaw String  @map("description_raw")
  quantity       Float
  unit           String?
  unitPrice      Float?  @map("unit_price")
  lineTotal      Float?  @map("line_total")
  matched        Boolean @default(false)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_lines")
}

// Every stock change is a movement. On-hand = SUM(quantity) per product+warehouse.
// check_in => positive, check_out => negative, adjustment => either sign.
model StockMovement {
  id              String   @id @default(cuid())
  type            String // "check_in" | "check_out" | "adjustment"
  productId       String   @map("product_id")
  warehouseId     String   @map("warehouse_id")
  technicianId    String?  @map("technician_id")
  quantity        Float
  // Canonical UoM code (lib/uom.ts) chosen at check-in/out. Nullable: when
  // unset the product's unitOfMeasure governs. Never free text.
  unit            String?
  unitPrice       Float?   @map("unit_price")
  sourceInvoiceId String?  @map("source_invoice_id")
  reason          String?
  userId          String?  @map("user_id")
  // Reconciliation: reversals reference the movement they undo. Nothing is ever
  // hard-deleted; a reversed movement stays and gets an offsetting entry.
  reversalOfId    String?  @unique @map("reversal_of_id")
  createdAt       DateTime @default(now()) @map("created_at")

  product       Product        @relation(fields: [productId], references: [id])
  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id])
  technician    Technician?    @relation(fields: [technicianId], references: [id])
  sourceInvoice Invoice?       @relation(fields: [sourceInvoiceId], references: [id])
  user          User?          @relation(fields: [userId], references: [id])
  reversalOf    StockMovement? @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy    StockMovement? @relation("Reversal")

  @@index([productId, warehouseId])
  @@index([warehouseId])
  @@index([type])
  @@index([createdAt])
  @@map("stock_movements")
}

model Alert {
  id        String   @id @default(cuid())
  type      String // "price_increase" | "duplicate_invoice" | "negative_stock" | "quantity_spike"
  productId String?  @map("product_id")
  message   String
  severity  String   @default("warning") // "info" | "warning" | "critical"
  status    String   @default("open") // "open" | "dismissed"
  // De-dupe key so the agent doesn't re-file the same anomaly every run.
  dedupeKey String?  @unique @map("dedupe_key")
  createdAt DateTime @default(now()) @map("created_at")

  product Product? @relation(fields: [productId], references: [id])

  @@index([status])
  @@map("alerts")
}

// ---------------------------------------------------------------------------
// Management reporting (board / management KPIs). Separate from inventory.
// Monthly snapshots of KPIs, each with actual vs budget, at company or branch
// scope. IMPORTANT: manager compensation is never stored or shown here.
// ---------------------------------------------------------------------------

// A reporting month, e.g. 2026-05 ("May 2026 Financials").
model ReportPeriod {
  id        String   @id @default(cuid())
  year      Int
  month     Int // 1-12
  label     String // e.g. "May 2026"
  createdAt DateTime @default(now()) @map("created_at")

  kpiValues   KpiValue[]
  lobRevenues LobRevenue[]
  techProd    TechProduction[]
  leadSources LeadSource[]

  @@unique([year, month])
  @@map("report_periods")
}

// A KPI definition. `group` buckets it in the UI; `higherIsBetter` drives
// favorable/unfavorable variance coloring (revenue up = good, fuel up = bad).
model Kpi {
  id             String  @id @default(cuid())
  key            String  @unique // e.g. "net_revenue", "ebitda_pct"
  label          String
  group          String // "Headline" | "Production" | "RouteContribution" | "PnL" | "Sales" | "Attrition" | "BalanceSheet"
  unit           String  @default("usd") // "usd" | "pct" | "pts" | "count"
  higherIsBetter Boolean @default(true)
  sortOrder      Int     @default(0)

  values KpiValue[]

  @@map("kpis")
}

// One KPI value for a period/scope/basis. scope = "company" or a branch key.
// basis = "month" | "ytd" | "cy_forecast".
model KpiValue {
  id       String @id @default(cuid())
  periodId String @map("period_id")
  kpiKey   String @map("kpi_key")
  scope    String @default("company") // "company" | "vero" | "stuart" | "orlando" | "naples"
  basis    String @default("month") // "month" | "ytd" | "cy_forecast"
  actual   Float?
  budget   Float?

  period ReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  kpi    Kpi          @relation(fields: [kpiKey], references: [key])

  @@unique([periodId, kpiKey, scope, basis])
  @@index([kpiKey])
  @@map("kpi_values")
}

// Per-branch MONTHLY budget targets (+ known actuals) for the three headline
// manager-scorecard categories: production, new_sales, cancellations. Source is
// the CEO's 2026 Branch KPIs workbook, which reconciles to the budget model.
// Kept separate from KpiValue because it spans the full year INCLUDING future
// months (so the quarterly scorecard targets and the dashboard forecast lines
// have forward figures) without creating empty future ReportPeriods. Actuals
// here are the workbook's own (Q1); current-quarter actuals still come from the
// live MBR/KpiValue data — see lib/branch-kpis.ts.
model BranchKpiTarget {
  id     String @id @default(cuid())
  branch String // "vero" | "stuart" | "orlando" | "naples"
  year   Int
  month  Int // 1-12
  kpiKey String @map("kpi_key") // "production" | "new_sales" | "cancellations"
  target Float?
  actual Float?

  @@unique([branch, year, month, kpiKey])
  @@index([branch, year, kpiKey])
  @@map("branch_kpi_targets")
}

// Revenue by line of business (service category) per branch per period.
model LobRevenue {
  id         String  @id @default(cuid())
  periodId   String  @map("period_id")
  scope      String  @default("company") // "company" | branch key
  lob        String // "Pest" | "Fertilizer" | "L&O" | "Termite" | "Rat" | ...
  revenue    Float   @default(0)
  jobs       Int?
  budget     Float?

  period ReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, scope, lob])
  @@map("lob_revenue")
}

// New-sales lead sources per period/scope. leads/won drive close rate when
// that lead-level data is available (not in the MBR — fed separately).
model LeadSource {
  id           String  @id @default(cuid())
  periodId     String  @map("period_id")
  scope        String  @default("company")
  source       String
  revenueMonth Float   @default(0) @map("revenue_month")
  revenueYtd   Float?  @map("revenue_ytd")
  leads        Int?
  won          Int?

  period ReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, scope, source])
  @@map("lead_sources")
}

// Per-technician production (NOT compensation). Production actual vs budget so
// managers can see who is over/under plan. No wage or comp fields, ever.
model TechProduction {
  id       String  @id @default(cuid())
  periodId String  @map("period_id")
  scope    String // branch key
  techName String  @map("tech_name")
  lob      String? // "PC" | "LO" | "Service" | ...
  actual   Float   @default(0)
  budget   Float   @default(0)

  period ReportPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([periodId, scope])
  @@map("tech_production")
}

// Quarterly branch-manager bonus scorecard. One row per (quarter, branch,
// metric). Binary Met/Not-Met per the company template; targets are entered by
// the reviewer (some come from the MBR budget, some TBD). Weighted to 100%.
model ScorecardResult {
  id        String   @id @default(cuid())
  year      Int
  quarter   Int // 1-4
  branch    String // "vero" | "stuart" | "orlando" | "naples"
  metricKey String   @map("metric_key")
  target    String? // reviewer-entered target (free text; some TBD)
  met       Boolean? // null = not yet scored
  note      String?
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([year, quarter, branch, metricKey])
  @@index([year, quarter, branch])
  @@map("scorecard_results")
}

// The quarterly manager-scorecard REVIEW document — the completion lifecycle
// wrapper around the per-metric ScorecardResult rows. One review per
// (year, quarter, branch). Mirrors the company's Q1 2026 manager-review format:
// a header, the 8-KPI performance table (from ScorecardResult), four narrative
// reviewer-comment fields, and a three-signer sign-off block. Lifecycle:
// draft → (three signatures) signed → (admin finalize) archived. Once archived
// it is immutable — a weighted score is computed, a PersonnelRecord is filed on
// the manager's employee profile, and further edits/signs are rejected unless an
// admin explicitly reopens it (logged).
model ScorecardReview {
  id      String @id @default(cuid())
  year    Int
  quarter Int // 1-4
  branch  String // "vero" | "stuart" | "orlando" | "naples"
  // "draft"    — supervisor/admin still filling toggles + comments (editable)
  // "final"    — published & locked; supervisor has signed; awaiting the
  //              manager's signature (via emailed token or in-app)
  // "archived" — both signed; filed to the profile + branch hub; immutable
  status  String @default("draft") // "draft" | "final" | "archived"

  // Publish → manager e-sign flow.
  publishedAt   DateTime? @map("published_at")
  signToken     String?   @unique @map("sign_token") // manager's emailed sign link
  bonusNotifiedAt DateTime? @map("bonus_notified_at") // HR bonus-payout email idempotency
  // Set true when an already-archived review is reopened & edited, so the next
  // archive notifies every stakeholder that the published version CHANGED.
  editedAfterArchive Boolean @default(false) @map("edited_after_archive")

  // Header block (the company template's part 1).
  managerName  String?   @map("manager_name")
  reviewerName String?   @map("reviewer_name") // reviewer name(s), free text
  reviewDate   DateTime? @map("review_date")

  // Reviewer comments (the company template's part 3) — four free-text fields.
  overallNotes String? @map("overall_notes")
  strengths    String?
  areas        String?
  goals        String?

  // Computed on finalize: the weighted Met/Not score (0-100).
  score Int?

  // Filed personnel-record link (set on archive): the manager's Employee and the
  // PersonnelRecord that was written onto their file.
  employeeId        String? @map("employee_id")
  personnelRecordId String? @map("personnel_record_id")

  finalizedAt DateTime? @map("finalized_at")
  archivedAt  DateTime? @map("archived_at")
  // Admin reopen audit (nullable — set only if an archived review is reopened).
  reopenedAt  DateTime? @map("reopened_at")
  reopenedBy  String?   @map("reopened_by")
  reopenNote  String?   @map("reopen_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  signatures ScorecardSignature[]

  @@unique([year, quarter, branch])
  @@index([branch, status])
  @@map("scorecard_reviews")
}

// One typed-signature attestation on a ScorecardReview. Three signers finalize a
// review: two reviewers (role "reviewer") + the manager (role "manager"). Typed
// full name + optional title + timestamp — a valid e-signature for in-person
// capture, matching the PersonnelSignature pattern.
model ScorecardSignature {
  id        String   @id @default(cuid())
  reviewId  String   @map("review_id")
  role      String // "reviewer" | "manager"
  typedName String   @map("typed_name")
  title     String?
  signedAt  DateTime @default(now()) @map("signed_at")

  review ScorecardReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("scorecard_signatures")
}

// ---------------------------------------------------------------------------
// Fleet management. Vehicle registry + maintenance/repair/cost history, so
// operating cost, cost-per-mile, and replacement timing can be tracked. GPS
// integration (auto next-service scheduling) is a later phase; the next-due
// fields are here so it can slot in.
// ---------------------------------------------------------------------------
model Vehicle {
  id             String    @id @default(cuid())
  unitNumber     String?   @map("unit_number") // fleet unit / asset number
  name           String // e.g. "2019 Ford Transit 250"
  year           Int?
  make           String?
  model          String?
  vin            String?   @unique
  plate          String?
  branch         String? // "vero" | "stuart" | "orlando" | "naples"
  assignedTo     String?   @map("assigned_to") // technician / driver name (kept in sync with assignedEmployee)
  // Structured driver link. assignedTo (the name string) is kept in sync so all
  // existing name-based matching keeps working; this FK is the durable link.
  assignedEmployeeId String? @map("assigned_employee_id")
  assignedEmployee   Employee? @relation("VehicleDriver", fields: [assignedEmployeeId], references: [id])
  status         String    @default("active") // "active" | "inactive" (sold/retired/etc.)
  acquiredDate   DateTime? @map("acquired_date")
  purchasePrice  Float?    @map("purchase_price")

  // Disposition (when no longer in service). All data is retained; the vehicle
  // just moves to the sold/retired list.
  disposition      String?   // "sold" | "retired" | "totaled" | "traded" | "transferred"
  dispositionDate  DateTime? @map("disposition_date")
  salePrice        Float?    @map("sale_price")
  dispositionNotes String?   @map("disposition_notes")
  currentMileage Int?      @map("current_mileage")
  mileageAsOf    DateTime? @map("mileage_as_of") // date the mileage reading is from
  statusNotes    String?   @map("status_notes") // replacement/condition notes

  // Registration / access / telematics
  driverCard          String?   @map("driver_card") // fuel card (Coast)
  driverLicense       String?   @map("driver_license")
  registrationRenewal DateTime? @map("registration_renewal")
  gps                 String? // GPS device / "NO GPS"

  // GPS tracking (Verizon Connect Reveal). `verizonNumber` is the Reveal vehicle
  // number this record is linked to (set on sync when a match is found by
  // VIN/plate/unit/name); `verizonLinkedAt` records when the link was made.
  verizonNumber   String?   @map("verizon_number")
  verizonLinkedAt DateTime? @map("verizon_linked_at")

  // Financing (loan). hasLoan is derived from these being present.
  loanBank       String?   @map("loan_bank")
  loanNumber     String?   @map("loan_number")
  monthlyPayment Float?    @map("monthly_payment")
  loanBalance    Float?    @map("loan_balance")
  payoffDate     DateTime? @map("payoff_date") // maturity

  createdAt      DateTime  @default(now()) @map("created_at")

  services    VehicleService[]
  inspections VehicleInspection[]
  documents   VehicleDocument[]
  reminders   Reminder[]
  fuel        FuelTransaction[]
  gpsPositions GpsPosition[]
  gpsTrips     GpsTrip[]
  gpsAlerts    GpsAlert[]

  @@index([branch])
  @@index([verizonNumber])
  @@index([assignedEmployeeId])
  @@map("vehicles")
}

// ---------------------------------------------------------------------------
// GPS tracking (Verizon Connect Reveal). Phase 1: a near-real-time position
// store fed by a server-side sync (latest status-history entry per vehicle) and
// a webhook receiver. On-hand rule doesn't apply here — these are append-mostly
// telemetry snapshots, deduped by (verizonNumber, ts). No credentials are ever
// stored; the connector reads them from env server-side only.
// ---------------------------------------------------------------------------

// A single near-real-time position snapshot for a vehicle (from the latest
// status/history entry, or synthesized sample data when Verizon isn't
// configured). `vehicleId` is null when the Reveal vehicle isn't linked yet.
model GpsPosition {
  id            String   @id @default(cuid())
  vehicleId     String?  @map("vehicle_id")
  verizonNumber String   @map("verizon_number")
  ts            DateTime
  lat           Float
  lng           Float
  speed         Float?
  heading       Float?
  address       String?
  ignition      Boolean?
  odometer      Float?
  sample        Boolean  @default(false) // true = synthesized demo data (Verizon not configured)
  raw           String?  // raw JSON from Reveal (kept for traceability)
  createdAt     DateTime @default(now()) @map("created_at")

  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@unique([verizonNumber, ts])
  @@index([vehicleId, ts])
  @@map("gps_positions")
}

// A journey or stop for a vehicle on a given day (from /rad segments).
model GpsTrip {
  id            String   @id @default(cuid())
  vehicleId     String?  @map("vehicle_id")
  verizonNumber String   @map("verizon_number")
  day           DateTime
  startTs       DateTime? @map("start_ts")
  endTs         DateTime? @map("end_ts")
  kind          String    @default("other") // "journey" | "stop" | "other"
  distanceMi    Float?    @map("distance_mi")
  startAddress  String?   @map("start_address")
  endAddress    String?   @map("end_address")
  sample        Boolean   @default(false)
  raw           String?
  createdAt     DateTime  @default(now()) @map("created_at")

  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@unique([verizonNumber, startTs, kind])
  @@index([vehicleId, day])
  @@map("gps_trips")
}

// One sync run (manual "Refresh" or cron). Captures counts + ok/error so the
// Live Map can show the last sync time and surface failures without throwing.
model GpsSyncLog {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  ok         Boolean   @default(false)
  vehicles   Int       @default(0)
  positions  Int       @default(0)
  trips      Int       @default(0)
  error      String?
  note       String?

  @@index([startedAt])
  @@map("gps_sync_logs")
}

// A raw push event from Verizon Connect Reveal (alerts arrive via webhooks —
// there is no Alerts REST API). Stored best-effort and processed later.
model GpsWebhookEvent {
  id            String   @id @default(cuid())
  receivedAt    DateTime @default(now()) @map("received_at")
  type          String?
  verizonNumber String?  @map("verizon_number")
  payload       String
  processed     Boolean  @default(false)

  @@index([receivedAt])
  @@map("gps_webhook_events")
}

// A GPS-domain alert raised by the detection engine (lib/gps-detect.ts). This is
// SEPARATE from the inventory `Alert` model — GPS alerts live in their own
// section (/fleet/gps/alerts) with their own ack/dismiss lifecycle. Rules
// (speeding, idle, after-hours, offline, out-of-area) are deterministic and run
// only on REAL (sample:false) telemetry; `ai_pattern` alerts come from the
// optional Claude layer. Never hard-deleted — ack/dismiss changes `status`.
// `dedupeKey` is unique so re-running detection never duplicates a finding, and
// an ack'd/dismissed alert is not reopened for the same key.
model GpsAlert {
  id             String    @id @default(cuid())
  type           String // "speeding" | "idle" | "after_hours" | "offline" | "out_of_area" | "ai_pattern"
  severity       String    @default("warning") // "info" | "warning" | "critical"
  vehicleId      String?   @map("vehicle_id")
  verizonNumber  String?   @map("verizon_number")
  branch         String?
  title          String
  detail         String?
  evidence       String? // JSON: supporting data (positions, values, window)
  status         String    @default("open") // "open" | "ack" | "dismissed"
  dedupeKey      String    @unique @map("dedupe_key") // stable per (type+vehicle+window) so re-runs don't duplicate
  aiGenerated    Boolean   @default(false) @map("ai_generated")
  acknowledgedBy String?   @map("acknowledged_by")
  resolvedAt     DateTime? @map("resolved_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([status, type])
  @@map("gps_alerts")
}

// A single line from a Coast fuel-card statement. Purchases link to a vehicle
// (by card ID, then plate, then unit number); account-level rows (subscription
// fees, auto-payments, rebates) carry no vehicle. On-hand fuel cost per vehicle
// = SUM(amount) of its linked purchases. Idempotent import keyed by dedupeKey.
model FuelTransaction {
  id        String  @id @default(cuid())
  vehicleId String? @map("vehicle_id")

  date       DateTime
  postedTime String?  @map("posted_time")
  driverName String?  @map("driver_name")
  merchant   String?
  description String?
  type       String   @default("Purchase") // "Purchase" | "Fee" | "Credit" | "Bill Payment"
  category   String?
  amount     Float    @default(0)

  // Where the row came from: "upload" (a parsed Coast .xlsx statement) or
  // "coast" (the live Coast API sync). Null on legacy rows loaded before this
  // field existed (treated as statement uploads).
  source String? // "upload" | "coast"
  // Coast purchase status for API-sourced rows: "completed" | "pending" |
  // "declined" | "canceled". Null for statement uploads.
  status String?

  gallons       Float?
  costPerGallon Float? @map("cost_per_gallon")
  fuelGrade     String? @map("fuel_grade")
  odometer      Int?
  calculatedMpg Float? @map("calculated_mpg")
  mileageDriven Int?   @map("mileage_driven")

  // As printed on the statement (kept even when we link by card/unit, so plate
  // discrepancies against the registry stay visible).
  cardId    String? @map("card_id")
  cardLast4 String? @map("card_last4")
  plate     String?
  branch    String?

  // How we linked it: "card" | "plate" | "plate_fuzzy" | "unit" | "account" | "none".
  matchMethod String? @map("match_method")

  statementNumber String?   @map("statement_number")
  periodStart     DateTime? @map("period_start")
  periodEnd       DateTime? @map("period_end")

  dedupeKey String   @unique @map("dedupe_key")
  createdAt DateTime @default(now()) @map("created_at")

  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([date])
  @@index([type])
  @@map("fuel_transactions")
}

// A manual reminder / alert a manager or HR sets, optionally tagged to an
// employee or a vehicle (e.g. "move Sam to Auto-Owners after 6-month
// probation"). Surfaces on dashboards and the tagged profile, and emails the
// chosen recipients starting `leadDays` before it's due.
model Reminder {
  id       String   @id @default(cuid())
  title    String
  notes    String?
  dueDate  DateTime @map("due_date")
  leadDays Int      @default(14) @map("lead_days")
  severity String   @default("info") // "info" | "warning" | "critical"
  status   String   @default("open") // "open" | "done" | "dismissed"

  entityType String  @default("general") @map("entity_type") // "employee" | "vehicle" | "general"
  employeeId String? @map("employee_id")
  vehicleId  String? @map("vehicle_id")
  branch     String?

  notify         String    @default("hr") // "hr" | "creator" | "both"
  lastReminderAt DateTime? @map("last_reminder_at")

  createdByUserId String?  @map("created_by_user_id")
  createdByName   String?  @map("created_by_name")
  createdByEmail  String?  @map("created_by_email")
  createdAt       DateTime @default(now()) @map("created_at")

  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  vehicle  Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([status, dueDate])
  @@index([employeeId])
  @@index([vehicleId])
  @@map("reminders")
}

// A document attached to a vehicle profile — insurance policy, registration,
// title, etc. Uploaded through the Document Center, where the AI reads it and
// proposes where it should be filed (which vehicle + category) before the user
// confirms. Expiration dates drive renewal reminders to HR.
model VehicleDocument {
  id        String  @id @default(cuid())
  vehicleId String? @map("vehicle_id") // null until filed / confirmed
  category  String  @default("other") // "insurance" | "registration" | "title" | "inspection" | "other"
  title     String
  fileName  String  @map("file_name")
  filePath  String? @map("file_path")
  fileSize  Int?    @map("file_size")
  mimeType  String? @map("mime_type")

  // Extracted / entered metadata.
  insurer        String?
  policyNumber   String?   @map("policy_number")
  effectiveDate  DateTime? @map("effective_date")
  expirationDate DateTime? @map("expiration_date")
  notes          String?

  // AI routing suggestion (kept for transparency after filing).
  aiSummary            String? @map("ai_summary")
  aiSuggestedVehicleId String? @map("ai_suggested_vehicle_id")
  aiSuggestedCategory  String? @map("ai_suggested_category")
  status               String  @default("pending") // "pending" (awaiting confirm) | "filed"

  // Renewal reminders → HR.
  remindHr       Boolean   @default(true) @map("remind_hr")
  lastReminderAt DateTime? @map("last_reminder_at")

  uploadedByUserId String?  @map("uploaded_by_user_id")
  uploadedByName   String?  @map("uploaded_by_name")
  createdAt        DateTime @default(now()) @map("created_at")

  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([status])
  @@index([expirationDate])
  @@map("vehicle_documents")
}

model VehicleService {
  id            String    @id @default(cuid())
  vehicleId     String    @map("vehicle_id")
  date          DateTime
  type          String // "oil_change" | "repair" | "inspection" | "tires" | "pm" | "other"
  description   String?
  cost          Float     @default(0)
  mileage       Int? // odometer at service
  vendor        String?
  invoiceRef    String?   @map("invoice_ref")
  nextDueMileage Int?     @map("next_due_mileage")
  nextDueDate   DateTime? @map("next_due_date")
  createdAt     DateTime  @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_services")
}

// Monthly on-site vehicle inspection completed by a branch manager. Mirrors the
// paper form: condition ratings (1-3), a maintenance-log review, and pass/fail
// compliance checks (FDACS / insurance / maintenance). Scores the technician
// assigned to the vehicle and feeds the quarterly scorecard's inspection metric.
model VehicleInspection {
  id             String   @id @default(cuid())
  vehicleId      String   @map("vehicle_id")
  branch         String?
  year           Int
  month          Int // 1-12 — one inspection per vehicle per month
  date           DateTime // date the inspection was performed
  employeeId     String?  @map("employee_id") // personnel profile of the graded driver
  technicianName String?  @map("technician_name") // driver assigned to the vehicle (graded)
  inspectorName  String?  @map("inspector_name") // manager completing the form

  // Section A — condition ratings (1-3) and per-item "issues to address" notes.
  ratings      String @default("{}") // {"outside":3,"inside":2,"toolbox":3,"truckbed":1}
  ratingIssues String @default("{}") @map("rating_issues")

  // Section C — FDACS / insurance / maintenance pass-fail checks (1 pt each).
  checks String @default("{}") // {"id_card":true,"pesticides_locked":true,...}

  // Section B — routine maintenance log review.
  oilChangeLast    DateTime? @map("oil_change_last")
  oilChangeNext    DateTime? @map("oil_change_next")
  tireRotationLast DateTime? @map("tire_rotation_last")
  tireRotationNext DateTime? @map("tire_rotation_next")
  otherMaintLast   DateTime? @map("other_maint_last")
  otherMaintNext   DateTime? @map("other_maint_next")
  mileage          Int?
  notes            String?

  // Computed grade (points earned out of maxScore).
  score    Int    @default(0)
  maxScore Int    @default(20) @map("max_score")
  scorePct Float  @default(0) @map("score_pct")
  grade    String @default("") // A | B | C | D | F

  createdAt DateTime @default(now()) @map("created_at")

  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id])

  @@unique([vehicleId, year, month])
  @@index([branch, year, month])
  @@index([technicianName])
  @@index([employeeId])
  @@map("vehicle_inspections")
}

// ---------------------------------------------------------------------------
// People / HR. A personnel profile for every employee. Inspection reports and
// (future) annual reviews tag to the profile so scores accrue to the person.
// ---------------------------------------------------------------------------
model Employee {
  id            String    @id @default(cuid())
  name          String
  email         String? // work email (for emailing inspection scores); filled later
  phone         String? // WORK phone
  personalPhone String?   @map("personal_phone") // personal/cell number (separate from work phone)
  role          String? // "Technician" | "Manager" | "Sales Advisor" | ...
  division      String? // "Lawn" | "Service" | "General Pest" | ...
  branch        String? // "vero" | "stuart" | "orlando" | "naples"
  title         String?
  status        String    @default("active") // "active" | "inactive" (former employee)
  hireDate      DateTime? @map("hire_date")
  birthMonth    Int?      @map("birth_month") // 1-12; no birth year stored (privacy) — feeds birthday celebrations
  birthDay      Int?      @map("birth_day") // 1-31
  terminatedAt  DateTime? @map("terminated_at")
  licenseNumber String?   @map("license_number")
  // Org chart: who this employee reports to (their team lead / manager). Forms a
  // self-referencing tree — a person's "team" is everyone in the subtree beneath
  // them. Powers the visual org chart and team-scoped Admin-Lite access.
  reportsToId   String?   @map("reports_to_id")
  reportsTo     Employee?  @relation("OrgChart", fields: [reportsToId], references: [id], onDelete: SetNull)
  reports       Employee[] @relation("OrgChart")
  ptoAllowanceDays Int?   @map("pto_allowance_days") // annual PTO allotment set by HR (null = use default)
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  inspections VehicleInspection[]
  rideAlongs  AuditRideAlong[]
  assignments TrainingAssignment[]
  records     PersonnelRecord[]
  reviews     NewHireReview[]
  separation  EmployeeSeparation?
  reminders   Reminder[]
  branchDocuments BranchDocument[]
  ptoRequests PtoRequest[]
  absences    Absence[]
  user        User?
  assignedVehicles Vehicle[] @relation("VehicleDriver")

  @@index([branch])
  @@index([name])
  @@map("employees")
}

// Paid-time-off request. An employee submits a date range to their branch
// supervisor, who approves or denies it. Approved days log against the
// employee's annual allotment (Employee.ptoAllowanceDays); `days` is the count
// of business days (Mon–Fri) in the inclusive range. Nothing is hard-deleted —
// an employee cancels a still-pending request; decided requests keep the
// reviewer + decision for the audit trail and feed the PTO calendar.
model PtoRequest {
  id             String    @id @default(cuid())
  employeeId     String    @map("employee_id")
  startDate      DateTime  @map("start_date")
  endDate        DateTime  @map("end_date")
  days           Int // number of PTO (business) days requested
  type           String    @default("vacation") // vacation | sick | personal | unpaid | other
  note           String?
  status         String    @default("pending") // pending | approved | denied | cancelled
  reviewedById   String?   @map("reviewed_by_id")
  reviewedByName String?   @map("reviewed_by_name")
  decidedAt      DateTime? @map("decided_at")
  decisionNote   String?   @map("decision_note")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@map("pto_requests")
}

// Unplanned employee ABSENCE / call-out. Deliberately SEPARATE from PtoRequest:
// there is no allowance/balance — this is an HR monitoring record for spotting
// attendance PATTERNS, plus a compliance-driven medical-note rule. Nothing is
// ever hard-deleted (HR audit record); corrections are made with `update`.
//
// COMPLIANCE: we store the medical-note STATUS only (none/requested/received/
// waived) — NEVER a diagnosis or any medical detail. "waived" is the FMLA/ADA
// path. On-hand math philosophy doesn't apply here (no balance) — each row is
// simply a logged occurrence.
model Absence {
  id            String   @id @default(cuid())
  employeeId    String   @map("employee_id")
  branch        String?                          // denormalized from the employee for scoping/rollup
  startDate     DateTime @map("start_date")
  endDate       DateTime @map("end_date")        // inclusive; equals startDate for a single day
  days          Int                              // inclusive calendar-day count of the span
  reason        String                           // canonical code (see REASONS in lib/absence.ts)
  reasonDetail  String?  @map("reason_detail")   // REQUIRED when reason="other"; optional note otherwise
  excused       Boolean?                         // HR/manager determination; null = undetermined
  // Physical-injury linkage
  workplaceRelated Boolean? @map("workplace_related")  // REQUIRED non-null when reason="physical_injury"
  accidentRecordId String?  @map("accident_record_id") // -> PersonnelRecord(id) where type="accident"
  // Medical-note tracking (illness > 2 days). STATUS ONLY — no medical details.
  noteRequired   Boolean   @default(false) @map("note_required")
  noteStatus     String    @default("none") @map("note_status") // "none" | "requested" | "received" | "waived"
  noteResolvedAt DateTime? @map("note_resolved_at")
  noteResolvedBy String?   @map("note_resolved_by")
  loggedById     String?   @map("logged_by_id")
  loggedByName   String?   @map("logged_by_name")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([branch])
  @@map("absences")
}

// Manager-submitted personnel records about an employee: write-ups, coaching
// notes, recognition, and workplace accident reports. Every submission is
// emailed to HR and filed on the employee's profile.
model PersonnelRecord {
  id           String    @id @default(cuid())
  employeeId   String    @map("employee_id")
  branch       String?
  type         String // "writeup" | "note" | "recognition" | "accident"
  category     String? // writeup: verbal|written|final|pip ; accident: minor|recordable|serious
  title        String?
  body         String?
  incidentDate DateTime? @map("incident_date")
  actionTaken  String?   @map("action_taken")
  followUp     String?   @map("follow_up")
  details      String    @default("{}") // JSON: accident fields + manager checklist state
  attachmentFile String? @map("attachment_file")
  attachmentName String? @map("attachment_name")
  authorId     String?   @map("author_id")
  authorName   String?   @map("author_name")
  hrNotified   Boolean   @default(false) @map("hr_notified")
  acknowledgedAt DateTime? @map("acknowledged_at") // future: employee sign-off
  createdAt    DateTime  @default(now()) @map("created_at")

  employee          Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  signatures        PersonnelSignature[]
  signatureRequests SignatureRequest[]

  @@index([employeeId])
  @@index([branch, type])
  @@map("personnel_records")
}

// Electronic signature on a personnel record (write-up / accident report).
// Typed full name + acknowledgment statement + timestamp + attribution — a
// valid e-signature under E-SIGN / UETA for in-person capture.
model PersonnelSignature {
  id             String   @id @default(cuid())
  recordId       String   @map("record_id")
  role           String // "employee" | "supervisor" | "hr" | "witness"
  signerName     String   @map("signer_name")
  statement      String? // the acknowledgment text agreed to
  signedByUserId String?  @map("signed_by_user_id") // the logged-in user who captured it
  signedAt       DateTime @default(now()) @map("signed_at")

  record PersonnelRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
  @@map("personnel_signatures")
}

// Offboarding record for a terminated / departed employee. Holds the reason,
// supporting documents, and the HR-conducted exit interview (which HR may
// bypass when a separation is not on good terms). Created when an employee is
// moved to inactive; the profile and all linked data are retained.
model EmployeeSeparation {
  id             String  @id @default(cuid())
  employeeId     String  @unique @map("employee_id")
  separationType String  @map("separation_type") // "voluntary" | "involuntary" | "layoff" | "other"
  reasonCategory String? @map("reason_category") // resignation | performance | misconduct | attendance | job_abandonment | layoff | other
  reasonNotes    String? @map("reason_notes")
  lastDay        DateTime @map("last_day")
  rehireEligible Boolean? @map("rehire_eligible")

  // Supporting documents — JSON array of { file, name }.
  docs String @default("[]")

  // HR-conducted exit interview.
  exitStatus       String    @default("pending") // "pending" | "completed" | "bypassed"
  exitBypassReason String?   @map("exit_bypass_reason")
  exitResponses    String    @default("{}") @map("exit_responses") // JSON answers
  exitInterviewAt  DateTime? @map("exit_interview_at")
  exitInterviewBy  String?   @map("exit_interview_by")

  createdByUserId String?  @map("created_by_user_id")
  createdByName   String?  @map("created_by_name")
  createdAt       DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_separations")
}

// New-hire 30 / 60-day review. HR-managed: scheduled off the start date, sent
// to a reviewer (supervisor/coordinator), completed & signed by reviewer +
// employee, then finally approved & signed by the HR director. Three signatures.
model NewHireReview {
  id         String   @id @default(cuid())
  employeeId String   @map("employee_id")
  branch     String?
  type       String // "30_day" | "60_day"
  startDate  DateTime @map("start_date")
  dueDate    DateTime @map("due_date")
  // due -> sent -> in_progress -> pending_approval -> completed
  status     String   @default("due")

  reviewerUserId String? @map("reviewer_user_id")
  reviewerName   String? @map("reviewer_name")

  responses     String  @default("{}") // form answers
  overallRating String? @map("overall_rating")
  nextSteps     String? @map("next_steps")
  hrNotes       String? @map("hr_notes")

  // Three e-signatures.
  reviewerSignedName String?   @map("reviewer_signed_name")
  reviewerSignedAt   DateTime? @map("reviewer_signed_at")
  employeeSignedName String?   @map("employee_signed_name")
  employeeSignedAt   DateTime? @map("employee_signed_at")
  hrSignedName       String?   @map("hr_signed_name")
  hrSignedAt         DateTime? @map("hr_signed_at")

  // Remote-sign token for the employee (emailed link when not on-site).
  employeeToken     String?   @unique @map("employee_token")
  lastReminderAt    DateTime? @map("last_reminder_at")

  hrNotifiedAt DateTime? @map("hr_notified_at")
  sentAt       DateTime? @map("sent_at")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, type])
  @@index([status])
  @@index([branch, status])
  @@map("newhire_reviews")
}

// A remote e-signature request: a tokenized link emailed to a signer who isn't
// with the manager (e.g. an injured employee sent home). They open the link and
// sign without logging in. Reminders re-send daily until signed.
model SignatureRequest {
  id             String    @id @default(cuid())
  recordId       String    @map("record_id")
  role           String
  token          String    @unique
  email          String
  signerName     String?   @map("signer_name")
  sentAt         DateTime  @default(now()) @map("sent_at")
  lastReminderAt DateTime? @map("last_reminder_at")
  signedAt       DateTime? @map("signed_at")
  createdById    String?   @map("created_by_id")

  record PersonnelRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
  @@index([signedAt])
  @@map("signature_requests")
}

// ---------------------------------------------------------------------------
// Training / LMS. Admins create courses (uploaded material + a quiz) and assign
// them to employees with a due date. Completions file into the employee's
// personnel profile and feed the manager scorecard + year-end review.
// ---------------------------------------------------------------------------
model Course {
  id            String   @id @default(cuid())
  title         String
  category      String   @default("ceu") // "onboarding" | "ceu"
  description   String? // lesson body / summary (markdown-ish text)
  materialFile  String?  @map("material_file") // uploaded lesson (pdf/slides), best-effort stored
  materialName  String?  @map("material_name")
  questions     String   @default("[]") // JSON: [{prompt, options:[...], correctIndex}]
  passingScore  Int      @default(80) @map("passing_score") // percent
  active        Boolean  @default(true)
  // Set true once a course's content is edited in the portal, so the deploy
  // seed stops overwriting it on redeploy (in-portal edits win). Seed-managed
  // courses stay false and keep re-syncing from code.
  contentLocked Boolean  @default(false) @map("content_locked")
  createdById   String?  @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  assignments TrainingAssignment[]

  @@index([category])
  @@map("courses")
}

model TrainingAssignment {
  id           String    @id @default(cuid())
  courseId     String    @map("course_id")
  employeeId   String    @map("employee_id")
  branch       String? // snapshot of the employee's branch (for manager rollups)
  assignedById String?   @map("assigned_by_id")
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  dueDate      DateTime? @map("due_date")

  status      String    @default("not_started") // "not_started" | "in_progress" | "completed"
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  answers     String    @default("{}") // JSON: {questionIndex: chosenIndex}
  score       Int? // percent
  passed      Boolean?
  attempts    Int       @default(0)

  // Email cadence: assignment notice + daily reminders until complete.
  notifiedAt     DateTime? @map("notified_at")
  lastReminderAt DateTime? @map("last_reminder_at")

  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([courseId, employeeId])
  @@index([employeeId, status])
  @@index([branch, status])
  @@map("training_assignments")
}

// Outbound email log. Every send (or skip when no provider is configured) is
// recorded so admin/HR can see what went out. The sender is provider-agnostic.
model EmailLog {
  id          String   @id @default(cuid())
  to          String
  subject     String
  kind        String // "inspection_score" | "audit_report" | ...
  status      String // "sent" | "skipped_no_provider" | "skipped_no_address" | "error"
  error       String?
  relatedType String?  @map("related_type")
  relatedId   String?  @map("related_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([kind])
  @@map("email_logs")
}

// ---------------------------------------------------------------------------
// Internal discussions. A lightweight threaded message system so managers, HR,
// management, and employees can discuss an item (a reminder, an alert, an
// employee, a vehicle — or nothing in particular) inside the app instead of
// jumping to email. Each participant has their own read state: opening the
// thread clears their unread "alert". Notifications also go out by email.
// ---------------------------------------------------------------------------
model Thread {
  id      String @id @default(cuid())
  subject String
  branch  String?
  status  String @default("open") // "open" | "resolved"

  // What this thread is about — used to deep-link back to the source item.
  contextType  String  @default("general") @map("context_type") // "reminder" | "alert" | "employee" | "vehicle" | "general"
  contextId    String? @map("context_id")
  contextLabel String? @map("context_label")
  contextHref  String? @map("context_href")

  createdByUserId String?  @map("created_by_user_id")
  createdByName   String?  @map("created_by_name")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  participants ThreadParticipant[]
  messages     ThreadMessage[]

  @@index([status, updatedAt])
  @@index([branch])
  @@map("threads")
}

// A person linked to a thread. `userId` is set when they have a login (so it
// shows in their in-app inbox); `email` is always kept so email-only recipients
// (e.g. an employee without a login) still get notified. `lastReadAt` drives the
// per-person unread badge — null means never opened.
model ThreadParticipant {
  id         String    @id @default(cuid())
  threadId   String    @map("thread_id")
  userId     String?   @map("user_id")
  employeeId String?   @map("employee_id")
  name       String
  email      String?
  role       String    @default("member") // "owner" | "member"
  lastReadAt DateTime? @map("last_read_at")
  notifyEmail Boolean  @default(true) @map("notify_email")
  createdAt  DateTime  @default(now()) @map("created_at")

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId, lastReadAt])
  @@index([threadId])
  @@map("thread_participants")
}

model ThreadMessage {
  id           String   @id @default(cuid())
  threadId     String   @map("thread_id")
  authorUserId String?  @map("author_user_id")
  authorName   String   @map("author_name")
  body         String
  createdAt    DateTime @default(now()) @map("created_at")

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("thread_messages")
}

// ---------------------------------------------------------------------------
// Quarterly branch audit (Director of Field Ops). A pre-visit prep checklist,
// the on-site audit form (ride-alongs + facility + personnel), and follow-up
// action items with deadlines that alert the branch manager.
// ---------------------------------------------------------------------------
model BranchAudit {
  id          String   @id @default(cuid())
  branch      String
  year        Int
  quarter     Int // 1-4
  visitDate   DateTime @map("visit_date")
  auditorName String?  @map("auditor_name")
  status      String   @default("draft") // "draft" | "submitted"

  // Section scores stored as JSON keyed by item.
  facility  String @default("{}") // A + B: 1-3 ratings; C: yes/no
  personnel String @default("{}") // yes/no answers
  ratings   String @default("{}") // section overall 1-5 ratings (equipment, personnel)

  facilityIssues  String? @map("facility_issues")
  concerns        String? // branch-specific concerns
  suggestions     String? // engagement / inclusion suggestions
  nextQuarterPlan String? @map("next_quarter_plan")

  score       Int      @default(0)
  maxScore    Int      @default(0) @map("max_score")
  scorePct    Float    @default(0) @map("score_pct")
  submittedAt DateTime? @map("submitted_at")
  createdAt   DateTime @default(now()) @map("created_at")

  rideAlongs AuditRideAlong[]
  followUps  AuditFollowUp[]

  @@unique([branch, year, quarter])
  @@index([branch])
  @@map("branch_audits")
}

model AuditRideAlong {
  id          String  @id @default(cuid())
  auditId     String  @map("audit_id")
  employeeId  String? @map("employee_id")
  technicianName String? @map("technician_name")
  serviceType String? @map("service_type") // general_pest | termite | lawn | mosquito | rodent | other

  // 1-5 ratings.
  customerInteraction Int? @map("customer_interaction")
  serviceExecution    Int? @map("service_execution")
  equipmentPrep       Int? @map("equipment_prep")
  safety              Int?

  customerNotes  String? @map("customer_notes")
  executionNotes String? @map("execution_notes")
  equipmentNotes String? @map("equipment_notes")
  safetyNotes    String? @map("safety_notes")
  strengths      String?
  improvement    String?
  coaching       String?

  audit    BranchAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  employee Employee?   @relation(fields: [employeeId], references: [id])

  @@index([auditId])
  @@map("audit_ride_alongs")
}

model AuditFollowUp {
  id          String    @id @default(cuid())
  auditId     String    @map("audit_id")
  branch      String
  description String
  dueDate     DateTime? @map("due_date")
  status      String    @default("open") // "open" | "done"
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  audit BranchAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([branch, status])
  @@map("audit_follow_ups")
}

// Monthly warehouse safety inspection (FL Statute 482 / FDACS + OSHA). One per
// branch per month; feeds the scorecard's warehouse-inspection compliance.
model WarehouseInspection {
  id            String   @id @default(cuid())
  branch        String
  year          Int
  month         Int
  date          DateTime
  inspectorName String?  @map("inspector_name")

  checks   String @default("{}") // {itemKey: true/false}
  comments String @default("{}") // {itemKey: "corrective action"}
  notes    String?

  score    Int    @default(0)
  maxScore Int    @default(0) @map("max_score")
  scorePct Float  @default(0) @map("score_pct")
  grade    String @default("")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([branch, year, month])
  @@index([branch, year, month])
  @@map("warehouse_inspections")
}

// Pre-visit prep checklist for a branch/quarter (Director of Field Ops).
model AuditPrecheck {
  id        String   @id @default(cuid())
  branch    String
  year      Int
  quarter   Int
  items     String   @default("{}") // {itemKey: true/false}
  notes     String?
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([branch, year, quarter])
  @@map("audit_prechecks")
}

// ---------------------------------------------------------------------------
// Insurance. Every line of business (general liability, commercial auto, workers
// comp, property, umbrella, professional/E&O, cyber, EPLI, inland marine,
// management liability, D&O, …) is a policy row. Multiple policies can share a
// line and are broken out as sublines on the dashboard. Installments capture the
// payment schedule so monthly budgets can be forecast; documents hold the PDFs.
// ---------------------------------------------------------------------------
model InsurancePolicy {
  id     String @id @default(cuid())
  line   String // canonical line key (see INSURANCE_LINES)
  name   String // subline / descriptor, e.g. "Fleet Auto — Auto-Owners"
  carrier      String?
  policyNumber String? @map("policy_number")
  agent        String? // broker / agency
  status       String  @default("active") // "active" | "pending" | "application" | "expired" | "cancelled"

  effectiveDate  DateTime? @map("effective_date")
  expirationDate DateTime? @map("expiration_date")
  annualPremium  Float?    @map("annual_premium")
  notes          String?

  // Within-policy coverage breakdown — JSON [{name, limit, deductible, premium}].
  coverages String @default("[]")

  // Payment / financing (drives the monthly forecast).
  paymentMethod    String @default("direct") @map("payment_method") // "direct" | "financed" | "agency_bill"
  paymentFrequency String @default("annual") @map("payment_frequency") // "annual" | "semiannual" | "quarterly" | "monthly" | "financed"
  downPayment      Float? @map("down_payment")
  financedAmount   Float? @map("financed_amount")
  financeCharge    Float? @map("finance_charge")
  numberOfPayments Int?   @map("number_of_payments")
  paymentAmount    Float? @map("payment_amount")
  apr              Float?
  financeCompany   String? @map("finance_company")
  financeAccount   String? @map("finance_account")

  // AI extraction transparency + review state.
  aiSummary   String? @map("ai_summary")
  needsReview Boolean @default(false) @map("needs_review")

  remindHr        Boolean   @default(true) @map("remind_hr")
  lastReminderAt  DateTime? @map("last_reminder_at")
  createdByUserId String?   @map("created_by_user_id")
  createdByName   String?   @map("created_by_name")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  installments InsuranceInstallment[]
  documents    InsuranceDocument[]

  @@index([line])
  @@index([expirationDate])
  @@index([status])
  @@map("insurance_policies")
}

model InsuranceInstallment {
  id       String   @id @default(cuid())
  policyId String   @map("policy_id")
  dueDate  DateTime @map("due_date")
  amount   Float
  label    String?
  paid     Boolean  @default(false)

  policy InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@index([dueDate])
  @@map("insurance_installments")
}

model InsuranceDocument {
  id       String  @id @default(cuid())
  policyId String? @map("policy_id")
  title    String
  fileName String  @map("file_name")
  filePath String? @map("file_path")
  fileSize Int?    @map("file_size")
  mimeType String? @map("mime_type")
  category String  @default("policy") // "policy" | "dec_page" | "payment_schedule" | "endorsement" | "invoice" | "other"

  uploadedByName String?  @map("uploaded_by_name")
  createdAt      DateTime @default(now()) @map("created_at")

  policy InsurancePolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)

  @@index([policyId])
  @@map("insurance_documents")
}

// ---------------------------------------------------------------------------
// Branch hub. Per-branch documents (operator licensing, facility lease, other)
// and the key vendor / service contacts a new manager needs. A license doc is
// tied to the BRANCH it certifies AND (optionally) the employee who holds it —
// which may be a different home branch (Graham works out of Vero but is the
// certified operator for Orlando). Lease docs track rent + term for alerts.
// ---------------------------------------------------------------------------
model BranchDocument {
  id       String @id @default(cuid())
  branch   String // the branch this document belongs to (e.g. the branch a license certifies)
  category String // "licensing" | "lease" | "other"
  title    String
  fileName String? @map("file_name")
  filePath String? @map("file_path")
  mimeType String? @map("mime_type")
  fileSize Int?    @map("file_size")

  // Holder — the certified operator / signer. May be a different home branch.
  employeeId String? @map("employee_id")
  holderName String? @map("holder_name")

  // Licensing fields.
  licenseType    String?   @map("license_type") // "cpo" | "business" | "other"
  licenseNumber  String?   @map("license_number")
  categories     String? // e.g. "GHP,LAWN,WDO"
  issueDate      DateTime? @map("issue_date")
  expirationDate DateTime? @map("expiration_date")

  // Lease / facility fields.
  landlord         String?
  monthlyRent      Float?    @map("monthly_rent")
  priorMonthlyRent Float?    @map("prior_monthly_rent")
  rentAsOf         DateTime? @map("rent_as_of")
  leaseStart       DateTime? @map("lease_start")
  leaseEnd         DateTime? @map("lease_end")

  notes          String?
  remindHr       Boolean   @default(true) @map("remind_hr")
  lastReminderAt DateTime? @map("last_reminder_at")
  uploadedByName String?   @map("uploaded_by_name")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([branch, category])
  @@index([employeeId])
  @@index([expirationDate])
  @@map("branch_documents")
}

model BranchContact {
  id       String @id @default(cuid())
  branch   String
  category String // property_manager | maintenance | chemical_vendor | fdacs | vehicle_maintenance | vehicle_wrap | utilities | landlord | other
  name     String
  company  String?
  role     String?
  phone    String?
  email    String?
  website  String?
  notes    String?
  sortOrder Int    @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([branch, category])
  @@map("branch_contacts")
}

// Sales Center sync snapshots. Each row is one computed rollup of the hourly
// Google Sheet (opportunity-level export). The dashboard reads the latest "ok".
model SalesSnapshot {
  id       String   @id @default(cuid())
  syncedAt DateTime @default(now()) @map("synced_at")
  rowCount Int      @default(0) @map("row_count")
  status   String   @default("ok") // "ok" | "error"
  error    String?
  data     String   @default("{}") // JSON metrics blob

  @@index([syncedAt])
  @@map("sales_snapshots")
}

// Simple key/value app settings (e.g. price-increase threshold).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("settings")
}

// Company bulletin — culture-focused feed of stories, announcements, shoutouts,
// and events. Read-only for the company; only granted authors post. A post with
// an image renders as a photo tile with a title overlay; long-form posts open a
// detail page, while short ones (or a linkUrl) can link straight out.
model BulletinPost {
  id          String    @id @default(cuid())
  type        String    @default("story") // story | announcement | shoutout | event
  title       String
  excerpt     String? // short teaser shown on the tile
  body        String? // full story (markdown-ish plain text) shown on the detail page
  imagePath   String?   @map("image_path") // hero photo (durable storage), served auth-gated
  imageAlt    String?   @map("image_alt")
  linkUrl     String?   @map("link_url") // if set, the tile links here instead of a detail page
  eventDate   DateTime? @map("event_date") // for type=event / anything that belongs on the calendar
  eventEnd    DateTime? @map("event_end")
  location    String?
  honoreeId   String?   @map("honoree_id") // employee celebrated in a shoutout
  honoreeName String?   @map("honoree_name")
  branch      String? // null = company-wide; otherwise the branch it pertains to
  pinned      Boolean   @default(false) // featured at the top of the board
  published   Boolean   @default(true)
  publishAt   DateTime? @map("publish_at") // set for a scheduled post; promoted to published once due
  requireAck  Boolean   @default(false) @map("require_ack") // readers must confirm they've read it
  authorId    String?   @map("author_id")
  authorName  String?   @map("author_name")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  acks        BulletinAck[]

  @@index([published, pinned])
  @@index([type])
  @@map("bulletin_posts")
}

// One row per user who has confirmed they read a post that requires it. Gives
// authors/HR a compliance trail of who acknowledged a policy or safety notice.
model BulletinAck {
  id             String   @id @default(cuid())
  postId         String   @map("post_id")
  userId         String   @map("user_id")
  userName       String?  @map("user_name")
  branch         String?
  acknowledgedAt DateTime @default(now()) @map("acknowledged_at")

  post BulletinPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@map("bulletin_acks")
}

// ---------------------------------------------------------------------------
// Pre-hire onboarding. HR builds a pre-hire profile for a candidate and emails
// them a magic link (the candidate has NO company login). The candidate works
// through a step-by-step onboarding wizard (personal + emergency contact,
// drug-test consent, background-check authorization, policy acknowledgment) and
// submits. HR reviews and, on approval, the pre-hire converts into an active
// Employee with their info carried over. PRE-EMPLOYMENT ONLY — no payroll / tax
// / SSN / bank details (Paychex handles those after hire).
model PreHire {
  id             String    @id @default(cuid())
  name           String
  email          String // personal email — the magic-link target
  phone          String?
  position       String?
  branch         String? // "vero" | "stuart" | "orlando" | "naples"
  targetStart    DateTime? @map("target_start")
  // invited | in_progress | submitted | approved | hired | rejected
  status         String    @default("invited")
  token          String    @unique // random magic-link token (login-free access)
  packet         String    @default("standard")
  responses      String    @default("{}") // JSON keyed by step key
  currentStep    Int       @default(0) @map("current_step")
  invitedAt      DateTime  @default(now()) @map("invited_at")
  startedAt      DateTime? @map("started_at")
  submittedAt    DateTime? @map("submitted_at")
  approvedAt     DateTime? @map("approved_at")
  reviewedByName String?   @map("reviewed_by_name")
  employeeId     String?   @map("employee_id") // set on conversion to Employee
  createdByName  String?   @map("created_by_name")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  documents PreHireDocument[]

  @@index([status])
  @@map("prehires")
}

// A document tied to a pre-hire — candidate uploads or generated acknowledgment
// PDFs. Optional in v1 but defined so uploads can slot in later.
model PreHireDocument {
  id        String   @id @default(cuid())
  preHireId String   @map("prehire_id")
  kind      String // "upload" | "acknowledgment" | "other"
  title     String
  filePath  String?  @map("file_path")
  fileName  String?  @map("file_name")
  mimeType  String?  @map("mime_type")
  createdAt DateTime @default(now()) @map("created_at")

  preHire PreHire @relation(fields: [preHireId], references: [id], onDelete: Cascade)

  @@index([preHireId])
  @@map("prehire_documents")
}

// ---------------------------------------------------------------------------
// Hiring / ATS (applicant tracking). A Job posting collects Candidates who move
// through a pipeline (applied → screening → interviewing → offer → onboarding →
// hired / rejected). HR assigns Interviews to logged-in team members, who each
// complete a REQUIRED digital scorecard; a calendar invite (.ics + Google link)
// is generated on assignment. When a candidate reaches the offer / onboarding
// stage, a PreHire is created from the candidate (linked via Candidate.preHireId)
// and the EXISTING onboarding portal takes over; HR approval reuses
// approveAndConvert and marks the candidate "hired".
// ---------------------------------------------------------------------------
model Job {
  id                String   @id @default(cuid())
  title             String
  branch            String? // "vero" | "stuart" | "orlando" | "naples"
  openings          Int      @default(1)
  description       String?
  hiringManagerName String?  @map("hiring_manager_name")
  status            String   @default("open") // open | on_hold | filled | closed
  // Public application "front door": the unguessable slug for /apply/<token>.
  // Generated on create; backfilled for existing jobs in deploy-db.
  applyToken        String?  @unique @map("apply_token")
  // Interview handoff: the supervisor HR assigns to run in-person interviews for
  // this job, and the HR-set date interviews must be scheduled/completed by.
  interviewSupervisorId   String?   @map("interview_supervisor_id")
  interviewSupervisorName String?   @map("interview_supervisor_name")
  interviewDeadline       DateTime? @map("interview_deadline")
  // Forced-ranking → selection: a 48h window opens when the supervisor submits
  // the ranked shortlist; HR selects the finalist before it lapses.
  selectionDeadline       DateTime? @map("selection_deadline")
  // Editable hiring template library: the interview + HR-screening templates
  // assigned to this job. Nullable — when unset, the fill UIs fall back to the
  // role-matched template, then the default template for that kind, then the
  // legacy hardcoded questionnaire. Backfilled to null by `prisma db push`.
  interviewTemplateId String? @map("interview_template_id")
  screeningTemplateId String? @map("screening_template_id")
  // Close-out: the candidate selected when hiring completes (plain scalar id —
  // resolved manually, NOT a Prisma relation, since `candidates` already relates
  // this job to its Candidate rows) + when the job was filled/closed.
  hiredCandidateId  String?  @map("hired_candidate_id")
  filledAt          DateTime? @map("filled_at")
  createdByName     String?  @map("created_by_name")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  candidates Candidate[]

  @@index([status])
  @@map("jobs")
}

model Candidate {
  id            String   @id @default(cuid())
  jobId         String?  @map("job_id")
  name          String
  // Split name parts captured by the public application form. `name` stays
  // populated ("First Last") for back-compat with all existing ATS code.
  firstName     String?  @map("first_name")
  lastName      String?  @map("last_name")
  email         String
  phone         String?
  source        String? // where they came from (Indeed, referral, walk-in, …)
  resumePath    String?  @map("resume_path")
  resumeName    String?  @map("resume_name")
  // Mailing address + a short self-intro captured on the public application.
  addressStreet String?  @map("address_street")
  addressCity   String?  @map("address_city")
  addressState  String?  @map("address_state")
  addressZip    String?  @map("address_zip")
  about         String?  // "Tell us about yourself" (capped ~250 words)
  stage         String   @default("applied") // applied | screening | interviewing | ranked | selected | pre_hire | offer | onboarding | hired | excluded | rejected
  notes         String?
  preHireId     String?  @unique @map("prehire_id") // set once onboarding starts (links to PreHire)
  // Stage-specific exclusion (a RETAINED, reason-tagged archive — never a delete).
  // excludedStage records the stage the candidate was cut AT; keepWarm marks a
  // re-engageable finalist (e.g. an un-selected ranked runner-up).
  excludedReason String?   @map("excluded_reason")
  excludedStage  String?   @map("excluded_stage")
  excludedAt     DateTime? @map("excluded_at")
  excludedByName String?   @map("excluded_by_name")
  keepWarm       Boolean   @default(false) @map("keep_warm")
  // Screening (HR): booking-link request + call notes / completion.
  screeningRequestedAt DateTime? @map("screening_requested_at")
  screeningNotes       String?   @map("screening_notes")
  screeningCompletedAt DateTime? @map("screening_completed_at")
  // Structured answers to the assigned HR-screening template, keyed by question
  // id (JSON). Null for candidates screened before templates / with notes only.
  screeningResponses   String?   @map("screening_responses")
  // Interview handoff: the confirmed date/time the supervisor logs.
  interviewAt   DateTime? @map("interview_at")
  // Forced ranking (supervisor) → selection (HR).
  interviewRank Int?      @map("interview_rank")
  selectedAt    DateTime? @map("selected_at")
  selectedByName String?  @map("selected_by_name")
  createdByName String?  @map("created_by_name")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  job        Job?        @relation(fields: [jobId], references: [id], onDelete: SetNull)
  interviews Interview[]

  @@index([stage])
  @@index([jobId])
  @@map("candidates")
}

model Interview {
  id               String    @id @default(cuid())
  candidateId      String    @map("candidate_id")
  interviewerId    String?   @map("interviewer_id") // User id — the logged-in team member who conducts it
  interviewerName  String?   @map("interviewer_name")
  interviewerEmail String?   @map("interviewer_email")
  scheduledAt      DateTime? @map("scheduled_at")
  durationMins     Int       @default(45) @map("duration_mins")
  type             String    @default("in_person") // in_person | video
  location         String?
  meetingLink      String?   @map("meeting_link")
  // Reserved for a future Google Calendar API integration (Workspace service
  // account creates the event server-side + auto-generates a Meet link).
  calendarEventId  String?   @map("calendar_event_id")
  status           String    @default("scheduled") // scheduled | completed | cancelled
  assignedByName   String?   @map("assigned_by_name")
  responses        String    @default("{}") // JSON scorecard (competency ratings + notes + basics)
  overallRating    Int?      @map("overall_rating")
  recommendation   String? // strong_yes | yes | lean_yes | lean_no | no
  summary          String?
  // Set when the job is closed out and this interview's interviewer is notified
  // of the hiring result (idempotency guard for the outcome email).
  outcomeNotifiedAt DateTime? @map("outcome_notified_at")
  completedAt      DateTime? @map("completed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([status])
  @@index([interviewerId])
  @@map("interviews")
}

// ---------------------------------------------------------------------------
// Editable Hiring Template Library. HR/admin build reusable interview + HR-
// screening-call templates from (a) a seeded off-the-shelf question bank +
// role templates, (b) their own custom questions, and (c) an AI-assist that
// drafts/refines questions. A Job maps to one interview + one screening
// template; the supervisor interview form and the HR screening call render the
// assigned template. Nothing is hard-deleted — deactivating flips `active`.
// ---------------------------------------------------------------------------
model HiringTemplate {
  id            String   @id @default(cuid())
  kind          String // "interview" | "screening"
  name          String
  description   String?
  roleKeys      String   @default("[]") @map("role_keys") // JSON array of role/worker-type keys this template serves
  isDefault     Boolean  @default(false) @map("is_default") // the fallback template for its kind
  active        Boolean  @default(true)
  seedKey       String?  @unique @map("seed_key") // stable marker for idempotent seeding (null for HR-authored)
  createdByName String?  @map("created_by_name")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  questions HiringTemplateQuestion[]

  @@index([kind, active])
  @@map("hiring_templates")
}

model HiringTemplateQuestion {
  id           String  @id @default(cuid())
  templateId   String  @map("template_id")
  order        Int     @default(0)
  section      String? // grouping label / competency (e.g. "Safety & compliance")
  text         String // the question / prompt
  responseType String  @map("response_type") // "rating_1_5" | "yes_no" | "text" | "basics_yesno_unsure"
  required     Boolean @default(false)

  template HiringTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("hiring_template_questions")
}

// Off-the-shelf reusable question bank (categorized), separate from any
// template — HR browses + inserts these à la carte when building a template.
model QuestionBankItem {
  id           String  @id @default(cuid())
  kind         String // "interview" | "screening"
  category     String // e.g. "Reliability", "Safety", "Customer service", "Screening basics"
  roleHint     String? @map("role_hint") // optional role this fits best ("technician","sales","manager","csr","any")
  text         String
  responseType String  @map("response_type")
  active       Boolean @default(true)
  seedKey      String? @unique @map("seed_key") // stable marker for idempotent seeding

  @@index([kind, category])
  @@map("question_bank_items")
}

// Cascading company calendar — holidays, office closures / early releases, and
// general events. Birthdays and work anniversaries are DERIVED from employee
// profiles at read time (not stored here).
model CalendarEvent {
  id            String    @id @default(cuid())
  title         String
  kind          String    @default("event") // holiday | closure | early_release | event
  date          DateTime // event day (UTC midnight)
  endDate       DateTime? @map("end_date") // multi-day span (optional)
  timeLabel     String?   @map("time_label") // e.g. "Closing 1:00 PM"
  branch        String? // null = company-wide
  notes         String?
  createdByName String?   @map("created_by_name")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([date])
  @@map("calendar_events")
}

// Manager recurring oversight checklists. A template defines the (ordered,
// categorized) items for a cadence; a completion is a permanent, NON-EDITABLE,
// APPEND-ONLY signed attestation that a manager personally completed those items
// for a given branch + period (same audit principle as stock_movements — never
// mutate or hard-delete; one signed completion per template/branch/period).
model ChecklistTemplate {
  id        String   @id @default(cuid())
  key       String   @unique // "weekly" | "monthly"
  title     String
  cadence   String // "weekly" | "monthly"
  intro     String? // short blurb shown atop the run
  items     String // JSON: [{id,order,category,label,objective}]
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  completions ChecklistCompletion[]

  @@map("checklist_templates")
}

model ChecklistCompletion {
  id          String   @id @default(cuid())
  templateId  String   @map("template_id")
  cadence     String // denormalized for easy querying: "weekly" | "monthly"
  branch      String // "vero" | "stuart" | "orlando" | "naples"
  periodKey   String   @map("period_key") // weekly: "2026-W29" (ISO week); monthly: "2026-07"
  userId      String?  @map("user_id")
  signedName  String   @map("signed_name") // typed attestation signature
  attestation String // the statement text they signed
  itemResults String   @map("item_results") // JSON: [{itemId,checked,note}]
  createdAt   DateTime @default(now()) @map("created_at")

  template ChecklistTemplate @relation(fields: [templateId], references: [id])

  @@unique([templateId, branch, periodKey]) // one completion per branch per period
  @@index([branch, cadence])
  @@map("checklist_completions")
}

// A missed recurring checklist — a compliance infraction raised when a full
// period elapsed with NO signed completion for a branch. Created lazily+idempotently
// by sweepMissedChecklists() (unique on template/branch/period). This is the
// "penalty": a miss is REPORTED (oversight, alerts, the branch banner) and can be
// cleared ONLY by the CEO (admin) or the HR director — never the branch manager.
// A cleared miss is retained as history (the infraction log); never hard-deleted.
model ChecklistMiss {
  id            String    @id @default(cuid())
  templateId    String    @map("template_id")
  cadence       String
  branch        String
  periodKey     String    @map("period_key")
  periodLabel   String    @map("period_label")
  status        String    @default("open") // "open" | "cleared"
  clearedById   String?   @map("cleared_by_id")
  clearedByName String?   @map("cleared_by_name")
  clearedAt     DateTime? @map("cleared_at")
  clearNote     String?   @map("clear_note")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([templateId, branch, periodKey])
  @@index([branch, status])
  @@map("checklist_misses")
}

// Field Quality-Control inspection: a manager rides behind a technician and
// grades the completed treatment. Two forms (ghp | lo). Goal = 10 of each per
// month per branch. Each completed inspection is filed to the evaluated
// technician's personnel profile and archived in the Branch Hub; monthly
// completion feeds the quarterly manager scorecard.
model QcInspection {
  id                   String    @id @default(cuid())
  branch               String
  type                 String // "ghp" | "lo"
  periodKey            String    @map("period_key") // month of the inspection, "2026-08"
  acctNumber           String    @map("acct_number")
  customerFirst        String    @map("customer_first")
  customerLast         String    @map("customer_last")
  lastTreatment        DateTime? @map("last_treatment")
  inspectionDate       DateTime  @map("inspection_date")
  technicianEmployeeId String?   @map("technician_employee_id")
  technicianName       String    @map("technician_name")
  results              String // JSON: [{ itemId, result: "pass"|"fail"|"na" }]
  notes                String?
  passCount            Int       @default(0) @map("pass_count")
  failCount            Int       @default(0) @map("fail_count")
  naCount              Int       @default(0) @map("na_count")
  createdByUserId      String?   @map("created_by_user_id")
  createdByName        String    @map("created_by_name")
  personnelRecordId    String?   @map("personnel_record_id")
  createdAt            DateTime  @default(now()) @map("created_at")

  @@index([branch, periodKey, type])
  @@index([technicianEmployeeId])
  @@map("qc_inspections")
}

// ---------------------------------------------------------------------------
// Document center. Living company documents (the Employee Handbook, readable by
// everyone; the Manager Operating Manual, manager-only) rendered from Markdown.
// The handbook requires a typed-signature acknowledgment — captured in-app for
// logged-in staff, during onboarding for new hires, or via a login-free signed
// link for existing staff. Acknowledgments are an APPEND-ONLY record (same audit
// principle as stock_movements / checklist_completions — never mutate or delete).
// ---------------------------------------------------------------------------
model PolicyDocument {
  id        String  @id @default(cuid())
  slug      String  @unique // "employee-handbook" | "manager-manual"
  title     String
  kind      String // "handbook" | "manual"
  audience  String // "all" | "manager"
  version   Int     @default(1)
  summary   String?
  body      String // Markdown
  effective String? // effective / last-updated note
  published Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  acknowledgments DocumentAcknowledgment[]
  ackTokens       DocumentAckToken[]

  @@map("policy_documents")
}

model DocumentAcknowledgment {
  id             String   @id @default(cuid())
  documentId     String   @map("document_id")
  version        Int
  userId         String?  @map("user_id") // logged-in acknowledger
  employeeId     String?  @map("employee_id") // employee (onboarding / link)
  signedName     String   @map("signed_name") // typed signature
  email          String?
  source         String // "onboarding" | "link" | "in_app"
  acknowledgedAt DateTime @default(now()) @map("acknowledged_at")

  document PolicyDocument @relation(fields: [documentId], references: [id])

  @@index([documentId, version])
  @@map("document_acknowledgments")
}

model DocumentAckToken {
  id         String    @id @default(cuid())
  token      String    @unique
  documentId String    @map("document_id")
  employeeId String?   @map("employee_id")
  name       String? // pre-filled employee name
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  document PolicyDocument @relation(fields: [documentId], references: [id])

  @@map("document_ack_tokens")
}
