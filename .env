# Local sandbox database (SQLite). Committed defaults are safe — no secrets here.
DATABASE_URL="file:./dev.db"

# Session signing secret for manager auth (dev default; override in production).
AUTH_SECRET="dev-only-insecure-secret-change-me"

# --- Invoice AI reader (Check-In) ---
# Leave ANTHROPIC_API_KEY unset to use the built-in MOCK parser (returns sample
# lines so the whole flow demos with no key). Set it to use real Claude vision.
# ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-8"
