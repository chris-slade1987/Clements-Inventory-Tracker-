# Copy to .env.local (dev) or set in your host's env (production).

# Sandbox: SQLite file. Production: a Postgres connection string, e.g.
#   DATABASE_URL="postgresql://user:pass@host:5432/clements?schema=public"
DATABASE_URL="file:./dev.db"

# Random 32+ char string. Generate: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Anthropic Claude API key for live invoice parsing (Check-In).
# Leave empty to use the built-in mock parser.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-8"

# ---- Email (transactional) ------------------------------------------------
# Set RESEND_API_KEY to actually SEND email (inspection scores, training
# assignments/reminders, personnel-record notifications, e-signature links).
# Until it's set, every send is safely logged (EmailLog) and skipped.
RESEND_API_KEY=""
EMAIL_FROM="Clements Command & Control <no-reply@clementspestcontrol.com>"

# Public base URL used to build links in emails (e-sign links, training links).
APP_URL="https://your-app.vercel.app"

# ---- File storage (uploads) ----------------------------------------------
# Durable storage for uploaded documents (vehicle insurance/registration/title/
# bill of sale, personnel attachments, separation docs, training materials,
# invoices). Set BLOB_READ_WRITE_TOKEN to store in Vercel Blob (Vercel project →
# Storage → Blob). Unset = local ./public/uploads (dev only; not durable on
# serverless). See DEPLOY.md.
BLOB_READ_WRITE_TOKEN=""

# ---- Daily cron (reminders) ----------------------------------------------
# Vercel Cron hits /api/cron/daily once a day and sends this as a bearer token.
# Generate: openssl rand -hex 32
CRON_SECRET=""

# ---- GPS tracking (Verizon Connect Reveal) --------------------------------
# Server-side ONLY — these must NEVER reach the browser and are NEVER committed.
# Set all three of APP_ID / REST_USERNAME / REST_PASSWORD in Vercel to go live;
# leave them empty and the app runs on a built-in sample-data fallback so the
# Live Map + per-vehicle GPS panels still demo. See
# docs/Verizon_Connect_Reveal_API_Integration.md.
VERIZON_APP_ID=""
VERIZON_REST_USERNAME=""
VERIZON_REST_PASSWORD=""
# Data center: "us" (default) or "eu". Base host = https://fim.api.${region}.fleetmatics.com
VERIZON_REGION="us"
# Webhook receiver (/api/gps/webhook) auth. Reveal authenticates to us with HTTP
# Basic auth — pick a username + strong password, enter them in the Reveal webhook
# form, and mirror them here (must match exactly). When both are set, Basic auth
# is required on POST.
VERIZON_WEBHOOK_USER=""
VERIZON_WEBHOOK_PASSWORD=""
# Legacy alternative to Basic auth: a shared secret passed as ?token=<value>.
# Only used when the Basic-auth pair above is NOT set.
VERIZON_WEBHOOK_TOKEN=""

# ---- Notification recipients (optional overrides) -------------------------
# Defaults resolve to the seeded company addresses if unset.
HR_EMAIL="awilliford@clementspestcontrol.com"
FIELD_OPS_EMAIL="gfoster@clementspestcontrol.com"
COO_EMAIL="c.slade@clementspestcontrol.com"
OWNER_EMAIL="tslade@clementspestcontrol.com"
